@prefix : <http://www.semanticweb.org/aws-ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://www.semanticweb.org/aws-ontology> a owl:Ontology ;
    rdfs:label "AWS Resource Ontology" ;
    rdfs:comment "An ontology for describing AWS resources, services, and their relationships." ;
    owl:versionInfo "0.5.0" .

:AWSManagedPolicy a owl:Class ;
    rdfs:label "AWS Managed Policy" ;
    rdfs:comment "An AWS-provided managed policy" ;
    rdfs:subClassOf :ManagedPolicy ;
    owl:disjointWith :CustomerManagedPolicy .

:EBSSnapshot a owl:Class ;
    rdfs:label "EBS Snapshot" ;
    rdfs:comment "A snapshot of an EBS volume" ;
    rdfs:subClassOf :StorageResource .

:EC2AMI a owl:Class ;
    rdfs:label "EC2 AMI" ;
    rdfs:comment "An Amazon Machine Image for EC2 instances" ;
    rdfs:subClassOf :ComputeResource .

:EC2LoadBalancer a owl:Class ;
    rdfs:label "EC2 Load Balancer" ;
    rdfs:comment "A load balancer distributing traffic to EC2 instances" ;
    rdfs:subClassOf :NetworkingResource .

:EC2SecurityGroup a owl:Class ;
    rdfs:label "EC2 Security Group" ;
    rdfs:comment "A security group controlling EC2 instance access" ;
    rdfs:subClassOf :SecurityResource .

:ECSCluster a owl:Class ;
    rdfs:label "ECS Cluster" ;
    rdfs:comment "An Amazon Elastic Container Service cluster" ;
    rdfs:subClassOf :ComputeResource ;
    owl:disjointWith :EKSCluster,
        :FargateService .

:ECSTask a owl:Class ;
    rdfs:label "ECS Task" ;
    rdfs:comment "An ECS task running one or more containers" ;
    rdfs:subClassOf :ComputeResource .

:InternetGateway a owl:Class ;
    rdfs:label "Internet Gateway" ;
    rdfs:comment "A VPC internet gateway" ;
    rdfs:subClassOf :NetworkingResource .

:LambdaFunction a owl:Class ;
    rdfs:label "Lambda Function" ;
    rdfs:comment "An AWS Lambda function" ;
    rdfs:subClassOf :ComputeResource .

:NATGateway a owl:Class ;
    rdfs:label "NAT Gateway" ;
    rdfs:comment "A VPC NAT gateway" ;
    rdfs:subClassOf :NetworkingResource .

:RDSDatabase a owl:Class ;
    rdfs:label "RDS Database" ;
    rdfs:comment "A database within an RDS instance" ;
    rdfs:subClassOf :DatabaseResource .

:RDSInstance a owl:Class ;
    rdfs:label "RDS Instance" ;
    rdfs:comment "An Amazon RDS database instance" ;
    rdfs:subClassOf :DatabaseResource .

:S3Object a owl:Class ;
    rdfs:label "S3 Object" ;
    rdfs:comment "An object stored in an S3 bucket" ;
    rdfs:subClassOf :StorageResource .

:Subnet a owl:Class ;
    rdfs:label "Subnet" ;
    rdfs:comment "A subnet within a VPC" ;
    rdfs:subClassOf :NetworkingResource .

:activityOf a owl:ObjectProperty ;
    rdfs:label "activity of" ;
    rdfs:comment "Inverse of has activity" ;
    rdfs:domain :StepFunctionActivity ;
    rdfs:range :StepFunction ;
    owl:inverseOf :hasActivity .

:apiGatewayType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "API Gateway type" ;
    rdfs:comment "Type of API Gateway (REST, HTTP, or WebSocket)" ;
    rdfs:domain :APIGateway ;
    rdfs:range xsd:string .

:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "Indicates that a policy or security group applies to a resource" ;
    rdfs:domain :SecurityResource ;
    rdfs:range :AWSResource .

:approvalRequired a owl:DatatypeProperty ;
    rdfs:label "approval required" ;
    rdfs:comment "Whether approval is required for resource creation or modification" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:boolean .

:approvesUseOf a owl:ObjectProperty ;
    rdfs:label "approves use of" ;
    rdfs:comment "Inverse of requires approval from" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource ;
    owl:inverseOf :requiresApprovalFrom .

:attachmentOf a owl:ObjectProperty ;
    rdfs:label "attachment of" ;
    rdfs:comment "Inverse of attached to" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource ;
    owl:inverseOf :attachedTo .

:audits a owl:ObjectProperty ;
    rdfs:label "audits" ;
    rdfs:comment "Inverse of audited by" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource ;
    owl:inverseOf :auditedBy .

:availabilityZoneOf a owl:ObjectProperty ;
    rdfs:label "availability zone of" ;
    rdfs:comment "Inverse of has availability zone" ;
    rdfs:domain :AvailabilityZone ;
    rdfs:range :AWSRegion ;
    owl:inverseOf :hasAvailabilityZone .

:belongsToRegion a owl:ObjectProperty ;
    rdfs:label "belongs to region" ;
    rdfs:comment "Relates resources to the AWS region they reside in" ;
    rdfs:range :AWSRegion .

:belongsToVPC a owl:ObjectProperty ;
    rdfs:label "belongs to VPC" ;
    rdfs:comment "Relates resources to their VPC" ;
    rdfs:range :VPC .

:canAssumeRole a owl:ObjectProperty ;
    rdfs:label "can assume role" ;
    rdfs:comment "Relates an IAM principal (user or role) to an IAM role it is permitted to assume via sts:AssumeRole" ;
    rdfs:range :IAMRole .

:billingMode a owl:DatatypeProperty ;
    rdfs:label "billing mode" ;
    rdfs:comment "Billing mode (on-demand, reserved, spot, etc.)" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:bucketVersioning a owl:DatatypeProperty ;
    rdfs:label "bucket versioning" ;
    rdfs:comment "S3 bucket versioning status" ;
    rdfs:domain :S3Bucket ;
    rdfs:range xsd:boolean .

:budgetAllocated a owl:DatatypeProperty ;
    rdfs:label "budget allocated" ;
    rdfs:comment "Budget allocated for this resource in USD" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:decimal .

:chargedBy a owl:ObjectProperty ;
    rdfs:label "charged by" ;
    rdfs:comment "Inverse of incurs charge for" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource ;
    owl:inverseOf :incursChargeFor .

:cidrBlock a owl:DatatypeProperty ;
    rdfs:label "CIDR block" ;
    rdfs:comment "Network CIDR block" ;
    rdfs:domain :NetworkingResource ;
    rdfs:range xsd:string .

:clusterHosts a owl:ObjectProperty ;
    rdfs:label "cluster hosts" ;
    rdfs:comment "Inverse of runs on cluster" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource ;
    owl:inverseOf :runsOnCluster .

:complianceStandard a owl:DatatypeProperty ;
    rdfs:label "compliance standard" ;
    rdfs:comment "Compliance standard or regulation (SOC2, HIPAA, PCI-DSS, etc.)" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:complianceStatus a owl:DatatypeProperty ;
    rdfs:label "compliance status" ;
    rdfs:comment "Current compliance status (compliant, non-compliant, pending, exempt)" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:compliesWith a owl:ObjectProperty ;
    rdfs:label "complies with" ;
    rdfs:comment "Indicates compliance with standards, regulations, or policies" ;
    rdfs:domain :AWSResource .

:containedBy a owl:ObjectProperty ;
    rdfs:label "contained by" ;
    rdfs:comment "Inverse of contains" ;
    owl:inverseOf :contains .

:containerImageUsedBy a owl:ObjectProperty ;
    rdfs:label "container image used by" ;
    rdfs:comment "Inverse of uses container image" ;
    owl:inverseOf :usesContainerImage .

:containerPort a owl:DatatypeProperty ;
    rdfs:label "container port" ;
    rdfs:comment "Port exposed by container" ;
    rdfs:domain :ECSTaskDefinition ;
    rdfs:range xsd:integer .

:controlledByServiceControlPolicy a owl:ObjectProperty ;
    rdfs:label "controlled by service control policy" ;
    rdfs:comment "Relates AWS accounts to service control policies" ;
    rdfs:domain :AWSAccount ;
    rdfs:range :ServiceControlPolicy .

:controls a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "controls" ;
    rdfs:comment "Inverse of controlled by" ;
    owl:inverseOf :controlledBy .

:costCenter a owl:DatatypeProperty ;
    rdfs:label "cost center" ;
    rdfs:comment "Cost center identifier for billing allocation" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:cpu a owl:DatatypeProperty ;
    rdfs:label "CPU units" ;
    rdfs:comment "CPU units allocated to container or task" ;
    rdfs:domain :ECSTaskDefinition ;
    rdfs:range xsd:integer .

:createdAfter a owl:ObjectProperty ;
    rdfs:label "created after" ;
    rdfs:comment "Inverse of created before" ;
    owl:inverseOf :createdBefore .

:creationDate a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "creation date" ;
    rdfs:comment "Resource creation timestamp" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:dateTime .

:dataClassification a owl:DatatypeProperty ;
    rdfs:label "data classification" ;
    rdfs:comment "Data classification level (public, internal, confidential, restricted)" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:dependencyOf a owl:ObjectProperty ;
    rdfs:label "dependency of" ;
    rdfs:comment "Inverse of depends on" ;
    owl:inverseOf :dependsOn .

:deprecatedDate a owl:DatatypeProperty ;
    rdfs:label "deprecated date" ;
    rdfs:comment "Date when the resource was deprecated" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:dateTime .

:desiredCount a owl:DatatypeProperty ;
    rdfs:label "desired count" ;
    rdfs:comment "Desired number of running tasks in an ECS service" ;
    rdfs:domain :ECSService ;
    rdfs:range xsd:integer .

:desiredNodes a owl:DatatypeProperty ;
    rdfs:label "desired nodes" ;
    rdfs:comment "Desired number of nodes in the node group" ;
    rdfs:domain :EKSNodeGroup ;
    rdfs:range xsd:integer .

:encryptionRequired a owl:DatatypeProperty ;
    rdfs:label "encryption required" ;
    rdfs:comment "Whether encryption is required for compliance" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:boolean .

:endpoint a owl:DatatypeProperty ;
    rdfs:label "endpoint" ;
    rdfs:comment "SNS subscription endpoint (email address, phone number, URL, etc.)" ;
    rdfs:domain :SNSSubscription ;
    rdfs:range xsd:string .

:enforcedBy a owl:ObjectProperty ;
    rdfs:label "enforced by" ;
    rdfs:comment "Inverse of enforces" ;
    owl:inverseOf :enforces .

:environment a owl:DatatypeProperty ;
    rdfs:label "environment" ;
    rdfs:comment "Environment classification (dev, test, staging, production)" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:eventBusName a owl:DatatypeProperty ;
    rdfs:label "event bus name" ;
    rdfs:comment "Name of the EventBridge event bus" ;
    rdfs:domain :EventBridge ;
    rdfs:range xsd:string .

:eventPattern a owl:DatatypeProperty ;
    rdfs:label "event pattern" ;
    rdfs:comment "EventBridge rule event pattern in JSON" ;
    rdfs:domain :EventBridgeRule ;
    rdfs:range xsd:string .

:hasAction a owl:ObjectProperty ;
    rdfs:label "has action" ;
    rdfs:comment "Relates policy statements to their actions" ;
    rdfs:domain :PolicyStatement ;
    rdfs:range :Action .

:hasCondition a owl:ObjectProperty ;
    rdfs:label "has condition" ;
    rdfs:comment "Relates policy statements to their conditions" ;
    rdfs:domain :PolicyStatement ;
    rdfs:range :Condition .

:hasMember a owl:ObjectProperty ;
    rdfs:label "has member" ;
    rdfs:comment "Inverse of member of" ;
    owl:inverseOf :memberOf .

:hasPermissionBoundary a owl:ObjectProperty ;
    rdfs:label "has permission boundary" ;
    rdfs:comment "Relates IAM entities to their permission boundary policies" ;
    rdfs:domain :IAMRole,
        :IAMUser ;
    rdfs:range :IAMPermissionBoundary .

:hasPolicy a owl:ObjectProperty ;
    rdfs:label "has policy" ;
    rdfs:comment "Relates IAM entities (users, roles, groups) to their attached policies" ;
    rdfs:range :IAMPolicy ;
    owl:equivalentProperty :hasPolicyAttachment .

:hasPolicyAttachment a owl:ObjectProperty ;
    rdfs:label "has policy attachment" ;
    rdfs:comment "Relates IAM entities to their attached policies" ;
    rdfs:domain :IAMGroup,
        :IAMRole,
        :IAMUser ;
    rdfs:range :IAMPolicy .

:hasSource a owl:ObjectProperty ;
    rdfs:label "has source" ;
    rdfs:comment "Inverse of is source for" ;
    owl:inverseOf :isSourceFor .

:hasSubscriber a owl:ObjectProperty ;
    rdfs:label "has subscriber" ;
    rdfs:comment "Inverse of subscribes to" ;
    owl:inverseOf :subscribesTo .

:httpMethod a owl:DatatypeProperty ;
    rdfs:label "HTTP method" ;
    rdfs:comment "HTTP method (GET, POST, PUT, DELETE, etc.)" ;
    rdfs:domain :APIGatewayMethod ;
    rdfs:range xsd:string .

:imageDigest a owl:DatatypeProperty ;
    rdfs:label "image digest" ;
    rdfs:comment "SHA256 digest of the container image" ;
    rdfs:domain :ContainerImage ;
    rdfs:range xsd:string .

:imageId a owl:DatatypeProperty ;
    rdfs:label "image ID" ;
    rdfs:comment "AMI ID used by instance" ;
    rdfs:domain :EC2Instance ;
    rdfs:range xsd:string .

:imageTag a owl:DatatypeProperty ;
    rdfs:label "image tag" ;
    rdfs:comment "Tag of the container image" ;
    rdfs:domain :ContainerImage ;
    rdfs:range xsd:string .

:instanceType a owl:DatatypeProperty ;
    rdfs:label "instance type" ;
    rdfs:comment "EC2 instance type" ;
    rdfs:domain :EC2Instance ;
    rdfs:range xsd:string .

:integrationMethod a owl:DatatypeProperty ;
    rdfs:label "integration method" ;
    rdfs:comment "Method for API Gateway backend integration" ;
    rdfs:domain :APIGatewayMethod ;
    rdfs:range xsd:string .

:integrationWith a owl:ObjectProperty ;
    rdfs:label "integration with" ;
    rdfs:comment "Indicates integration between API Gateway methods and backend services" ;
    rdfs:domain :APIGatewayMethod .

:isDefault a owl:DatatypeProperty ;
    rdfs:label "is default" ;
    rdfs:comment "Whether this is a default resource" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:boolean .

:keyName a owl:DatatypeProperty ;
    rdfs:label "key name" ;
    rdfs:comment "EC2 key pair name" ;
    rdfs:domain :EC2Instance ;
    rdfs:range xsd:string .

:kubernetesVersion a owl:DatatypeProperty ;
    rdfs:label "Kubernetes version" ;
    rdfs:comment "Version of Kubernetes running on EKS cluster" ;
    rdfs:domain :EKSCluster ;
    rdfs:range xsd:string .

:lastAuditDate a owl:DatatypeProperty ;
    rdfs:label "last audit date" ;
    rdfs:comment "Date of the last compliance audit" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:dateTime .

:lastModifiedDate a owl:DatatypeProperty ;
    rdfs:label "last modified date" ;
    rdfs:comment "Date when the resource was last modified" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:dateTime .

:launchType a owl:DatatypeProperty ;
    rdfs:label "launch type" ;
    rdfs:comment "ECS launch type (EC2 or FARGATE)" ;
    rdfs:domain :ECSService ;
    rdfs:range xsd:string .

:logsActivityOf a owl:ObjectProperty ;
    rdfs:label "logs activity of" ;
    rdfs:comment "Relates logging resources to their subjects" ;
    rdfs:domain :CloudTrailLog ;
    rdfs:range :AWSAccount .

:managedBy a owl:ObjectProperty ;
    rdfs:label "managed by" ;
    rdfs:comment "Inverse of manages" ;
    owl:inverseOf :manages .

:maxNodes a owl:DatatypeProperty ;
    rdfs:label "maximum nodes" ;
    rdfs:comment "Maximum number of nodes in the node group" ;
    rdfs:domain :EKSNodeGroup ;
    rdfs:range xsd:integer .

:maxSessionDuration a owl:DatatypeProperty ;
    rdfs:label "max session duration" ;
    rdfs:comment "Maximum session duration in seconds" ;
    rdfs:domain :IAMRole ;
    rdfs:range xsd:integer .

:memory a owl:DatatypeProperty ;
    rdfs:label "memory" ;
    rdfs:comment "Memory allocated to container or task in MB" ;
    rdfs:domain :ECSTaskDefinition ;
    rdfs:range xsd:integer .

:messageRetentionPeriod a owl:DatatypeProperty ;
    rdfs:label "message retention period" ;
    rdfs:comment "SQS message retention period in seconds" ;
    rdfs:domain :SQSQueue ;
    rdfs:range xsd:integer .

:methodOf a owl:ObjectProperty ;
    rdfs:label "method of" ;
    rdfs:comment "Inverse of has method" ;
    owl:inverseOf :hasMethod .

:migratedTo a owl:ObjectProperty ;
    rdfs:label "migrated to" ;
    rdfs:comment "Inverse of migrated from" ;
    owl:inverseOf :migratedFrom .

:minNodes a owl:DatatypeProperty ;
    rdfs:label "minimum nodes" ;
    rdfs:comment "Minimum number of nodes in the node group" ;
    rdfs:domain :EKSNodeGroup ;
    rdfs:range xsd:integer .

:monitoredBy a owl:ObjectProperty ;
    rdfs:label "monitored by" ;
    rdfs:comment "Inverse of monitors" ;
    owl:inverseOf :monitors .

:monthlyCostUSD a owl:DatatypeProperty ;
    rdfs:label "monthly cost USD" ;
    rdfs:comment "Estimated monthly cost in USD" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:decimal .

:nextAuditDate a owl:DatatypeProperty ;
    rdfs:label "next audit date" ;
    rdfs:comment "Scheduled date for the next compliance audit" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:dateTime .

:nodeGroupOf a owl:ObjectProperty ;
    rdfs:label "node group of" ;
    rdfs:comment "Inverse of has node group" ;
    owl:inverseOf :hasNodeGroup .

:nodeInstanceType a owl:DatatypeProperty ;
    rdfs:label "node instance type" ;
    rdfs:comment "EC2 instance type for EKS worker nodes" ;
    rdfs:domain :EKSNodeGroup ;
    rdfs:range xsd:string .

:optimizes a owl:ObjectProperty ;
    rdfs:label "optimizes" ;
    rdfs:comment "Inverse of optimized by" ;
    owl:inverseOf :optimizedBy .

:path a owl:DatatypeProperty ;
    rdfs:label "path" ;
    rdfs:comment "IAM entity path" ;
    rdfs:domain :IdentityResource ;
    rdfs:range xsd:string .

:podRunsOn a owl:ObjectProperty ;
    rdfs:label "pod runs on" ;
    rdfs:comment "Inverse of runs pod" ;
    owl:inverseOf :runsPod .

:policyDocument a owl:DatatypeProperty ;
    rdfs:label "policy document" ;
    rdfs:comment "The JSON policy document content" ;
    rdfs:domain :IAMPolicy ;
    rdfs:range xsd:string .

:precedes a owl:ObjectProperty ;
    rdfs:label "precedes" ;
    rdfs:comment "Inverse of succeeds" ;
    owl:inverseOf :succeeds .

:queueReceivesFrom a owl:ObjectProperty ;
    rdfs:label "queue receives from" ;
    rdfs:comment "Inverse of sends to queue" ;
    owl:inverseOf :sendsToQueue .

:queueType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "queue type" ;
    rdfs:comment "SQS queue type (Standard or FIFO)" ;
    rdfs:domain :SQSQueue ;
    rdfs:range xsd:string .

:receivesCostFrom a owl:ObjectProperty ;
    rdfs:label "receives cost from" ;
    rdfs:comment "Inverse of allocates cost to" ;
    owl:inverseOf :allocatesCostTo .

:receivesEventFrom a owl:ObjectProperty ;
    rdfs:label "receives event from" ;
    rdfs:comment "Inverse of routes event to" ;
    owl:inverseOf :routesEventTo .

:regionOf a owl:ObjectProperty ;
    rdfs:label "region of" ;
    rdfs:comment "Inverse of has region" ;
    owl:inverseOf :hasRegion .

:replaces a owl:ObjectProperty ;
    rdfs:label "replaces" ;
    rdfs:comment "Inverse of replaced by" ;
    owl:inverseOf :replacedBy .

:repositoryContains a owl:ObjectProperty ;
    rdfs:label "repository contains" ;
    rdfs:comment "Inverse of stored in repository" ;
    owl:inverseOf :storedInRepository .

:repositoryURI a owl:DatatypeProperty ;
    rdfs:label "repository URI" ;
    rdfs:comment "URI of the ECR repository" ;
    rdfs:domain :ECRRepository ;
    rdfs:range xsd:string .

:reservationId a owl:DatatypeProperty ;
    rdfs:label "reservation ID" ;
    rdfs:comment "Reserved instance or capacity reservation identifier" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:resourceId a owl:DatatypeProperty ;
    rdfs:label "resource ID" ;
    rdfs:comment "AWS resource identifier" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:resourceName a owl:DatatypeProperty ;
    rdfs:label "resource name" ;
    rdfs:comment "Human-readable resource name" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:resourceOf a owl:ObjectProperty ;
    rdfs:label "resource of" ;
    rdfs:comment "Inverse of has resource" ;
    owl:inverseOf :hasResource .

:resourcePath a owl:DatatypeProperty ;
    rdfs:label "resource path" ;
    rdfs:comment "API Gateway resource path" ;
    rdfs:domain :APIGatewayResource ;
    rdfs:range xsd:string .

:resourceState a owl:DatatypeProperty ;
    rdfs:label "resource state" ;
    rdfs:comment "Current state of the resource" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:retentionPeriodDays a owl:DatatypeProperty ;
    rdfs:label "retention period days" ;
    rdfs:comment "Number of days to retain the resource or its data" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:integer .

:routesTrafficThrough a owl:ObjectProperty ;
    rdfs:label "routes traffic through" ;
    rdfs:comment "Indicates traffic routing relationships" ;
    rdfs:domain :RouteTable .

:ruleOf a owl:ObjectProperty ;
    rdfs:label "rule of" ;
    rdfs:comment "Inverse of has rule" ;
    owl:inverseOf :hasRule .

:scheduleExpression a owl:DatatypeProperty ;
    rdfs:label "schedule expression" ;
    rdfs:comment "Cron or rate expression for EventBridge scheduled rules" ;
    rdfs:domain :EventBridgeRule ;
    rdfs:range xsd:string .

:scheduledDeletion a owl:DatatypeProperty ;
    rdfs:label "scheduled deletion" ;
    rdfs:comment "Scheduled deletion date for the resource" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:dateTime .

:sharesResourcesWith a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "shares resources with" ;
    rdfs:comment "Indicates resource sharing for cost efficiency" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:stageName a owl:DatatypeProperty ;
    rdfs:label "stage name" ;
    rdfs:comment "Name of the API Gateway deployment stage" ;
    rdfs:domain :APIGatewayStage ;
    rdfs:range xsd:string .

:stageOf a owl:ObjectProperty ;
    rdfs:label "stage of" ;
    rdfs:comment "Inverse of has stage" ;
    owl:inverseOf :hasStage .

:stateMachineDefinition a owl:DatatypeProperty ;
    rdfs:label "state machine definition" ;
    rdfs:comment "JSON definition of the Step Function state machine" ;
    rdfs:domain :StepFunction ;
    rdfs:range xsd:string .

:stateMachineType a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "state machine type" ;
    rdfs:comment "Type of Step Function (STANDARD or EXPRESS)" ;
    rdfs:domain :StepFunction ;
    rdfs:range xsd:string .

:stepFunctionTriggeredBy a owl:ObjectProperty ;
    rdfs:label "step function triggered by" ;
    rdfs:comment "Inverse of triggers step function" ;
    owl:inverseOf :triggersStepFunction .

:subscriptionProtocol a owl:DatatypeProperty ;
    rdfs:label "subscription protocol" ;
    rdfs:comment "SNS subscription protocol (email, sms, http, https, sqs, lambda)" ;
    rdfs:domain :SNSSubscription ;
    rdfs:range xsd:string .

:targetOf a owl:ObjectProperty ;
    rdfs:label "target of" ;
    rdfs:comment "Inverse of has target" ;
    owl:inverseOf :hasTarget .

:taskDefinitionOf a owl:ObjectProperty ;
    rdfs:label "task definition of" ;
    rdfs:comment "Inverse of has task definition" ;
    owl:inverseOf :hasTaskDefinition .

:taskDefinitionRevision a owl:DatatypeProperty ;
    rdfs:label "task definition revision" ;
    rdfs:comment "Revision number of the task definition" ;
    rdfs:domain :ECSTaskDefinition ;
    rdfs:range xsd:integer .

:topicReceivesFrom a owl:ObjectProperty ;
    rdfs:label "topic receives from" ;
    rdfs:comment "Inverse of publishes to topic" ;
    owl:inverseOf :publishesToTopic .

