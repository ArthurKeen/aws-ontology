    rdfs:label "VPC" ;
    rdfs:comment "A Virtual Private Cloud" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :belongsToRegion ],
        :NetworkingResource .

:allocatesCostTo a owl:ObjectProperty ;
    rdfs:label "allocates cost to" ;
    rdfs:comment "Indicates cost allocation relationships" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:arn a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "ARN" ;
    rdfs:comment "Amazon Resource Name" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:attachedTo a owl:ObjectProperty ;
    rdfs:label "attached to" ;
    rdfs:comment "Relates resources that are attached to other resources" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:auditedBy a owl:ObjectProperty ;
    rdfs:label "audited by" ;
    rdfs:comment "Indicates audit relationships for compliance tracking" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:contains a owl:ObjectProperty ;
    rdfs:label "contains" ;
    rdfs:comment "General containment relationship" .

:controlledBy a owl:ObjectProperty ;
    rdfs:label "controlled by" ;
    rdfs:comment "Indicates control relationships for governance" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:createdBefore a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "created before" ;
    rdfs:comment "Indicates temporal ordering of resource creation" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:dependsOn a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "depends on" ;
    rdfs:comment "General dependency relationship between resources" .

:enforces a owl:ObjectProperty ;
    rdfs:label "enforces" ;
    rdfs:comment "Indicates that a resource enforces compliance rules" ;
    rdfs:domain :AWSResource .

:hasAvailabilityZone a owl:ObjectProperty ;
    rdfs:label "has availability zone" ;
    rdfs:comment "Relates a region to its availability zones" ;
    rdfs:domain :AWSRegion ;
    rdfs:range :AvailabilityZone .

:hasEffect a owl:ObjectProperty ;
    rdfs:label "has effect" ;
    rdfs:comment "Relates policy statements to their effects" ;
    rdfs:domain :PolicyStatement ;
    rdfs:range :Effect .

:hasMethod a owl:ObjectProperty ;
    rdfs:label "has method" ;
    rdfs:comment "Relates an API Gateway resource to its HTTP methods" ;
    rdfs:domain :APIGatewayResource ;
    rdfs:range :APIGatewayMethod .

:hasNodeGroup a owl:ObjectProperty ;
    rdfs:label "has node group" ;
    rdfs:comment "Relates EKS clusters to their node groups" ;
    rdfs:domain :EKSCluster ;
    rdfs:range :EKSNodeGroup .

:hasRegion a owl:ObjectProperty ;
    rdfs:label "has region" ;
    rdfs:comment "Relates an AWS account to its regions" ;
    rdfs:domain :AWSAccount ;
    rdfs:range :AWSRegion .

:hasResource a owl:ObjectProperty ;
    rdfs:label "has resource" ;
    rdfs:comment "Relates an API Gateway to its resources",
        "Relates policy statements to their target resources" ;
    rdfs:domain :APIGateway,
        :PolicyStatement ;
    rdfs:range :APIGatewayResource,
        :Resource .

:hasRule a owl:ObjectProperty ;
    rdfs:label "has rule" ;
    rdfs:comment "Relates an EventBridge to its rules" ;
    rdfs:domain :EventBridge ;
    rdfs:range :EventBridgeRule .

:hasStatement a owl:ObjectProperty ;
    rdfs:label "has statement" ;
    rdfs:comment "Relates policies to their statements" ;
    rdfs:domain :IAMPolicy ;
    rdfs:range :PolicyStatement .

:hasTrustRelationship a owl:ObjectProperty ;
    rdfs:label "has trust relationship" ;
    rdfs:comment "Relates IAM roles to their trust policies" ;
    rdfs:domain :IAMRole ;
    rdfs:range :IAMTrustPolicy .

:incursChargeFor a owl:ObjectProperty ;
    rdfs:label "incurs charge for" ;
    rdfs:comment "Indicates that one resource incurs costs for another" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:isSourceFor a owl:ObjectProperty ;
    rdfs:label "is source for" ;
    rdfs:comment "Indicates source relationship between resources" .

:manages a owl:ObjectProperty ;
    rdfs:label "manages" ;
    rdfs:comment "Indicates management relationship between resources" .

:migratedFrom a owl:ObjectProperty ;
    rdfs:label "migrated from" ;
    rdfs:comment "Indicates migration source for a resource" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:monitors a owl:ObjectProperty ;
    rdfs:label "monitors" ;
    rdfs:comment "Relates monitoring resources to their targets" ;
    rdfs:domain :CloudWatchAlarm ;
    rdfs:range :CloudWatchMetric .

:optimizedBy a owl:ObjectProperty ;
    rdfs:label "optimized by" ;
    rdfs:comment "Indicates cost or performance optimization relationships" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:publishesToTopic a owl:ObjectProperty ;
    rdfs:label "publishes to topic" ;
    rdfs:comment "Indicates that a service publishes messages to an SNS topic" ;
    rdfs:range :SNSTopic .

:replacedBy a owl:ObjectProperty ;
    rdfs:label "replaced by" ;
    rdfs:comment "Indicates that one resource was replaced by another" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:requiresApprovalFrom a owl:ObjectProperty ;
    rdfs:label "requires approval from" ;
    rdfs:comment "Indicates governance approval requirements" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:routesEventTo a owl:ObjectProperty ;
    rdfs:label "routes event to" ;
    rdfs:comment "Indicates event routing from EventBridge to target services" ;
    rdfs:domain :EventBridge .

:runsPod a owl:ObjectProperty ;
    rdfs:label "runs pod" ;
    rdfs:comment "Relates EKS node groups or clusters to their pods" ;
    rdfs:range :EKSPod .

:sendsToQueue a owl:ObjectProperty ;
    rdfs:label "sends to queue" ;
    rdfs:comment "Indicates that a service sends messages to an SQS queue" ;
    rdfs:range :SQSQueue .

:subscribesTo a owl:ObjectProperty ;
    rdfs:label "subscribes to" ;
    rdfs:comment "Indicates that a service subscribes to an SNS topic or SQS queue" .

:succeeds a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "succeeds" ;
    rdfs:comment "Indicates logical succession relationship between resources" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:triggersStepFunction a owl:ObjectProperty ;
    rdfs:label "triggers step function" ;
    rdfs:comment "Indicates that a service triggers a Step Function execution" ;
    rdfs:range :StepFunction .

:uses a owl:ObjectProperty ;
    rdfs:label "uses" ;
    rdfs:comment "Indicates usage relationship between resources" .

:usesContainerImage a owl:ObjectProperty ;
    rdfs:label "uses container image" ;
    rdfs:comment "Relates container services to their container images" ;
    rdfs:range :ContainerImage .

:APIGatewayStage a owl:Class ;
    rdfs:label "API Gateway Stage" ;
    rdfs:comment "A logical reference to a lifecycle state of an API Gateway deployment" ;
    rdfs:subClassOf :NetworkingResource .

:AWSRegion a owl:Class ;
    rdfs:label "AWS Region" ;
    rdfs:comment "A geographical region containing AWS resources" ;
    rdfs:subClassOf :AWSResource .

:EBSVolume a owl:Class ;
    rdfs:label "EBS Volume" ;
    rdfs:comment "An Elastic Block Store volume" ;
    rdfs:subClassOf :StorageResource .

:ECRRepository a owl:Class ;
    rdfs:label "ECR Repository" ;
    rdfs:comment "An Amazon Elastic Container Registry repository for container images" ;
    rdfs:subClassOf :StorageResource .

:FargateService a owl:Class ;
    rdfs:label "Fargate Service" ;
    rdfs:comment "A serverless container service using AWS Fargate" ;
    rdfs:subClassOf :ComputeResource .

:IAMGroup a owl:Class ;
    rdfs:label "IAM Group" ;
    rdfs:comment "An IAM user group" ;
    rdfs:subClassOf :IdentityResource .

:ManagedPolicy a owl:Class ;
    rdfs:label "Managed Policy" ;
    rdfs:comment "An IAM managed policy (AWS or Customer managed)" ;
    rdfs:subClassOf :IAMPolicy ;
    owl:disjointWith :InlinePolicy .

:SNSSubscription a owl:Class ;
    rdfs:label "SNS Subscription" ;
    rdfs:comment "An SNS subscription connecting a topic to an endpoint" ;
    rdfs:subClassOf :IntegrationResource .

:StepFunctionActivity a owl:Class ;
    rdfs:label "Step Function Activity" ;
    rdfs:comment "A Step Functions activity representing a task that can be implemented by external workers" ;
    rdfs:subClassOf :ComputeResource .

:hasActivity a owl:ObjectProperty ;
    rdfs:label "has activity" ;
    rdfs:comment "Relates a Step Function to its activities" ;
    rdfs:domain :StepFunction ;
    rdfs:range :StepFunctionActivity .

:hasStage a owl:ObjectProperty ;
    rdfs:label "has stage" ;
    rdfs:comment "Relates an API Gateway to its deployment stages" ;
    rdfs:domain :APIGateway ;
    rdfs:range :APIGatewayStage .

:hasTarget a owl:ObjectProperty ;
    rdfs:label "has target" ;
    rdfs:comment "Relates an EventBridge rule to its targets" ;
    rdfs:domain :EventBridgeRule ;
    rdfs:range :EventBridgeTarget .

:hasTaskDefinition a owl:ObjectProperty ;
    rdfs:label "has task definition" ;
    rdfs:comment "Relates ECS services/tasks to their task definition" ;
    rdfs:domain :ECSService ;
    rdfs:range :ECSTaskDefinition .

:memberOf a owl:ObjectProperty ;
    rdfs:label "member of" ;
    rdfs:comment "Relates IAM users to their groups" ;
    rdfs:domain :IAMUser ;
    rdfs:range :IAMGroup .

:runsOnCluster a owl:ObjectProperty ;
    rdfs:label "runs on cluster" ;
    rdfs:comment "Relates container services/tasks to their cluster" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:storedInRepository a owl:ObjectProperty ;
    rdfs:label "stored in repository" ;
    rdfs:comment "Relates container images to their ECR repository" ;
    rdfs:domain :ContainerImage ;
    rdfs:range :ECRRepository .

:APIGateway a owl:Class ;
    rdfs:label "API Gateway" ;
    rdfs:comment "An Amazon API Gateway for creating, publishing, maintaining, monitoring, and securing REST and WebSocket APIs" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasStage ],
        :NetworkingResource .

:APIGatewayResource a owl:Class ;
    rdfs:label "API Gateway Resource" ;
    rdfs:comment "A logical entity that an app developer accesses via API Gateway" ;
    rdfs:subClassOf :NetworkingResource .

:AWSAccount a owl:Class ;
    rdfs:label "AWS Account" ;
    rdfs:comment "An AWS account that can contain multiple services and resources" ;
    rdfs:subClassOf :AWSResource .

:EC2Instance a owl:Class ;
    rdfs:label "EC2 Instance" ;
    rdfs:comment "An Amazon EC2 virtual machine instance" ;
    rdfs:subClassOf :ComputeResource .

:EKSCluster a owl:Class ;
    rdfs:label "EKS Cluster" ;
    rdfs:comment "An Amazon Elastic Kubernetes Service cluster" ;
    rdfs:subClassOf :ComputeResource ;
    owl:disjointWith :FargateService .

:EventBridge a owl:Class ;
    rdfs:label "EventBridge" ;
    rdfs:comment "An Amazon EventBridge event bus for application integration using events" ;
    rdfs:subClassOf :IntegrationResource .

:IAMUser a owl:Class ;
    rdfs:label "IAM User" ;
    rdfs:comment "An IAM user entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "0"^^xsd:nonNegativeInteger ;
            owl:onProperty :memberOf ],
        :IdentityResource .

:APIGatewayMethod a owl:Class ;
    rdfs:label "API Gateway Method" ;
    rdfs:comment "An HTTP method for an API Gateway resource" ;
    rdfs:subClassOf :NetworkingResource .

:ContainerImage a owl:Class ;
    rdfs:label "Container Image" ;
    rdfs:comment "A container image stored in ECR or referenced by container services" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :storedInRepository ],
        :StorageResource .

:ECSService a owl:Class ;
    rdfs:label "ECS Service" ;
    rdfs:comment "An ECS service that runs and maintains tasks" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :runsOnCluster ],
        [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasTaskDefinition ],
        :ComputeResource .

:EventBridgeRule a owl:Class ;
    rdfs:label "EventBridge Rule" ;
    rdfs:comment "An EventBridge rule that matches incoming events and routes them to targets" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasTarget ],
        :IntegrationResource .

:IAMRole a owl:Class ;
    rdfs:label "IAM Role" ;
    rdfs:comment "An IAM role entity" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasTrustRelationship ],
        :IdentityResource .

:SQSQueue a owl:Class ;
    rdfs:label "SQS Queue" ;
    rdfs:comment "An Amazon Simple Queue Service message queue" ;
    rdfs:subClassOf :IntegrationResource .

:ECSTaskDefinition a owl:Class ;
    rdfs:label "ECS Task Definition" ;
    rdfs:comment "A blueprint for ECS tasks specifying containers and resources" ;
    rdfs:subClassOf :ComputeResource .

:EKSNodeGroup a owl:Class ;
    rdfs:label "EKS Node Group" ;
    rdfs:comment "A group of EC2 instances that serve as worker nodes in an EKS cluster" ;
    rdfs:subClassOf :ComputeResource .

:PolicyStatement a owl:Class ;
    rdfs:label "Policy Statement" ;
    rdfs:comment "A statement within an IAM policy" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasEffect ],
        :IdentityResource .

# Missing Compute Services
:AutoScalingGroup a owl:Class ;
    rdfs:label "Auto Scaling Group" ;
    rdfs:comment "An Amazon EC2 Auto Scaling group" ;
    rdfs:subClassOf :ComputeResource .

:ECSContainerInstance a owl:Class ;
    rdfs:label "ECS Container Instance" ;
    rdfs:comment "An EC2 instance registered to an ECS cluster" ;
    rdfs:subClassOf :ComputeResource .

# Missing Storage Services
:EFSFileSystem a owl:Class ;
    rdfs:label "EFS File System" ;
    rdfs:comment "An Amazon Elastic File System" ;
    rdfs:subClassOf :StorageResource .

:RDSCluster a owl:Class ;
    rdfs:label "RDS Cluster" ;
    rdfs:comment "An Amazon RDS database cluster" ;
    rdfs:subClassOf :DatabaseResource .

:RDSSnapshot a owl:Class ;
    rdfs:label "RDS Snapshot" ;
    rdfs:comment "A snapshot of an RDS database instance or cluster" ;
    rdfs:subClassOf :StorageResource .

# Missing Database Services  
:DynamoDBTable a owl:Class ;
    rdfs:label "DynamoDB Table" ;
    rdfs:comment "An Amazon DynamoDB table" ;
    rdfs:subClassOf :DatabaseResource .

:DocumentDBCluster a owl:Class ;
    rdfs:label "DocumentDB Cluster" ;
    rdfs:comment "An Amazon DocumentDB cluster" ;
    rdfs:subClassOf :DatabaseResource .

:RedshiftCluster a owl:Class ;
    rdfs:label "Redshift Cluster" ;
    rdfs:comment "An Amazon Redshift data warehouse cluster" ;
    rdfs:subClassOf :DatabaseResource .

# Missing Networking Services
:ElasticIP a owl:Class ;
    rdfs:label "Elastic IP" ;
    rdfs:comment "An Elastic IP address" ;
    rdfs:subClassOf :NetworkingResource .

:ELBv2TargetGroup a owl:Class ;
    rdfs:label "ELBv2 Target Group" ;
    rdfs:comment "An Application Load Balancer or Network Load Balancer target group" ;
    rdfs:subClassOf :NetworkingResource .

:NetworkInterface a owl:Class ;
    rdfs:label "Network Interface" ;
    rdfs:comment "An Elastic Network Interface (ENI)" ;
    rdfs:subClassOf :NetworkingResource .

:NetworkACL a owl:Class ;
    rdfs:label "Network ACL" ;
    rdfs:comment "A network access control list" ;
    rdfs:subClassOf :SecurityResource .

:VPCEndpoint a owl:Class ;
    rdfs:label "VPC Endpoint" ;
    rdfs:comment "A VPC endpoint for connecting to AWS services" ;
    rdfs:subClassOf :NetworkingResource .

# Missing Security Services
:KMSKey a owl:Class ;
    rdfs:label "KMS Key" ;
    rdfs:comment "An AWS Key Management Service encryption key" ;
    rdfs:subClassOf :SecurityResource .

:KMSAlias a owl:Class ;
    rdfs:label "KMS Alias" ;
    rdfs:comment "An alias for a KMS key" ;
    rdfs:subClassOf :SecurityResource .

:SecretsManagerSecret a owl:Class ;
    rdfs:label "Secrets Manager Secret" ;
    rdfs:comment "A secret stored in AWS Secrets Manager" ;
    rdfs:subClassOf :SecurityResource .

:SecurityGroupRule a owl:Class ;
    rdfs:label "Security Group Rule" ;
    rdfs:comment "A rule within a security group" ;
    rdfs:subClassOf :SecurityResource .

# Missing Identity Services
:IAMInstanceProfile a owl:Class ;
    rdfs:label "IAM Instance Profile" ;
    rdfs:comment "An instance profile that provides temporary credentials to EC2 instances" ;
    rdfs:subClassOf :IdentityResource .

# Missing Content Delivery Services
:CloudFrontDistribution a owl:Class ;
    rdfs:label "CloudFront Distribution" ;
    rdfs:comment "An Amazon CloudFront content delivery network distribution" ;
    rdfs:subClassOf :AWSResource .

:SecurityResource a owl:Class ;
    rdfs:label "Security Resource" ;
    rdfs:comment "Base class for security resources" ;
    rdfs:subClassOf :AWSResource ;
    owl:disjointWith :DatabaseResource,
        :IdentityResource,
        :IntegrationResource,
        :MonitoringResource .

:StepFunction a owl:Class ;
    rdfs:label "Step Function" ;
    rdfs:comment "An AWS Step Functions state machine for coordinating distributed services" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasActivity ],
        :ComputeResource .

:DatabaseResource a owl:Class ;
    rdfs:label "Database Resource" ;
    rdfs:comment "Base class for database resources" ;
    rdfs:subClassOf :AWSResource ;
    owl:disjointWith :IntegrationResource,
        :MonitoringResource .

:StorageResource a owl:Class ;
    rdfs:label "Storage Resource" ;
    rdfs:comment "Base class for storage resources" ;
    rdfs:subClassOf :AWSResource ;
    owl:disjointWith :DatabaseResource,
        :IdentityResource,
        :IntegrationResource,
        :MonitoringResource,
        :NetworkingResource,
        :SecurityResource .

:IAMPolicy a owl:Class ;
    rdfs:label "IAM Policy" ;
    rdfs:comment "Base class for all IAM policies" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasStatement ],
        :IdentityResource .

:MonitoringResource a owl:Class ;
    rdfs:label "Monitoring Resource" ;
    rdfs:comment "Base class for monitoring and logging resources" ;
    rdfs:subClassOf :AWSResource ;
    owl:disjointWith :IntegrationResource .

:IdentityResource a owl:Class ;
    rdfs:label "Identity Resource" ;
    rdfs:comment "Base class for identity and access management resources" ;
    rdfs:subClassOf :AWSResource ;
    owl:disjointWith :DatabaseResource,
        :IntegrationResource,
        :MonitoringResource .

:ComputeResource a owl:Class ;
    rdfs:label "Compute Resource" ;
    rdfs:comment "Base class for compute resources" ;
    rdfs:subClassOf :AWSResource ;
    owl:disjointWith :DatabaseResource,
        :IdentityResource,
        :IntegrationResource,
        :MonitoringResource,
        :NetworkingResource,
        :SecurityResource,
        :StorageResource .

:IntegrationResource a owl:Class ;
    rdfs:label "Integration Resource" ;
    rdfs:comment "Base class for application integration and messaging resources" ;
    rdfs:subClassOf :AWSResource .

:NetworkingResource a owl:Class ;
    rdfs:label "Networking Resource" ;
    rdfs:comment "Base class for networking resources" ;
    rdfs:subClassOf :AWSResource ;
    owl:disjointWith :DatabaseResource,
        :IdentityResource,
        :IntegrationResource,
        :MonitoringResource,
        :SecurityResource .

:targetKeyId a owl:ObjectProperty ;
    rdfs:label "target key ID" ;
    rdfs:comment "References the target KMS key for an alias" ;
    rdfs:domain :KMSAlias ;
    rdfs:range :KMSKey .

:protocol a owl:DatatypeProperty ;
    rdfs:label "protocol" ;
    rdfs:comment "Network protocol (HTTP, HTTPS, TCP, UDP, etc.)" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

# Additional data properties for newly added services
:aliasName a owl:DatatypeProperty ;
    rdfs:label "alias name" ;
    rdfs:comment "The name of a KMS key alias" ;
    rdfs:domain :KMSAlias ;
    rdfs:range xsd:string .

:attachedToSubnet a owl:ObjectProperty ;
    rdfs:label "attached to subnet" ;
    rdfs:comment "Network interface attachment to subnet" ;
    rdfs:domain :NetworkInterface ;
    rdfs:range :Subnet .

:createdFrom a owl:ObjectProperty ;
    rdfs:label "created from" ;
    rdfs:comment "Resource created from another resource" ;
    rdfs:domain :AWSResource ;
    rdfs:range :AWSResource .

:defaultRootObject a owl:DatatypeProperty ;
    rdfs:label "default root object" ;
    rdfs:comment "Default root object for CloudFront distribution" ;
    rdfs:domain :CloudFrontDistribution ;
    rdfs:range xsd:string .

:distributionId a owl:DatatypeProperty ;
    rdfs:label "distribution ID" ;
    rdfs:comment "CloudFront distribution identifier" ;
    rdfs:domain :CloudFrontDistribution ;
    rdfs:range xsd:string .

:domain a owl:DatatypeProperty ;
    rdfs:label "domain" ;
    rdfs:comment "Domain type (vpc, standard, etc.)" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:string .

:domainName a owl:DatatypeProperty ;
    rdfs:label "domain name" ;
    rdfs:comment "Domain name for CloudFront distribution" ;
    rdfs:domain :CloudFrontDistribution ;
    rdfs:range xsd:string .

:enabled a owl:DatatypeProperty ;
    rdfs:label "enabled" ;
    rdfs:comment "Whether resource is enabled" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:boolean .

:encrypted a owl:DatatypeProperty ;
    rdfs:label "encrypted" ;
    rdfs:comment "Whether resource is encrypted" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:boolean .

:encryptedWith a owl:ObjectProperty ;
    rdfs:label "encrypted with" ;
    rdfs:comment "KMS key used for encryption" ;
    rdfs:domain :AWSResource ;
    rdfs:range :KMSKey .

:engine a owl:DatatypeProperty ;
    rdfs:label "engine" ;
    rdfs:comment "Database engine type" ;
    rdfs:domain :DatabaseResource ;
    rdfs:range xsd:string .

:engineVersion a owl:DatatypeProperty ;
    rdfs:label "engine version" ;
    rdfs:comment "Database engine version" ;
    rdfs:domain :DatabaseResource ;
    rdfs:range xsd:string .

:fromPort a owl:DatatypeProperty ;
    rdfs:label "from port" ;
    rdfs:comment "Starting port number for security group rule" ;
    rdfs:domain :SecurityGroupRule ;
    rdfs:range xsd:integer .

:hasRole a owl:ObjectProperty ;
    rdfs:label "has role" ;
    rdfs:comment "IAM role associated with instance profile" ;
    rdfs:domain :IAMInstanceProfile ;
    rdfs:range :IAMRole .

:healthCheckPath a owl:DatatypeProperty ;
    rdfs:label "health check path" ;
    rdfs:comment "Health check path for target group" ;
    rdfs:domain :ELBv2TargetGroup ;
    rdfs:range xsd:string .

:instanceProfileName a owl:DatatypeProperty ;
    rdfs:label "instance profile name" ;
    rdfs:comment "Name of IAM instance profile" ;
    rdfs:domain :IAMInstanceProfile ;
    rdfs:range xsd:string .

:interfaceType a owl:DatatypeProperty ;
    rdfs:label "interface type" ;
    rdfs:comment "Type of network interface" ;
    rdfs:domain :NetworkInterface ;
    rdfs:range xsd:string .

:keySpec a owl:DatatypeProperty ;
    rdfs:label "key spec" ;
    rdfs:comment "KMS key specification" ;
    rdfs:domain :KMSKey ;
    rdfs:range xsd:string .

:keyUsage a owl:DatatypeProperty ;
    rdfs:label "key usage" ;
    rdfs:comment "KMS key usage" ;
    rdfs:domain :KMSKey ;
    rdfs:range xsd:string .

:maxInstances a owl:DatatypeProperty ;
    rdfs:label "max instances" ;
    rdfs:comment "Maximum number of instances" ;
    rdfs:domain :AutoScalingGroup ;
    rdfs:range xsd:integer .

:minInstances a owl:DatatypeProperty ;
    rdfs:label "min instances" ;
    rdfs:comment "Minimum number of instances" ;
    rdfs:domain :AutoScalingGroup ;
    rdfs:range xsd:integer .

:multiAZ a owl:DatatypeProperty ;
    rdfs:label "multi AZ" ;
    rdfs:comment "Whether resource spans multiple availability zones" ;
    rdfs:domain :DatabaseResource ;
    rdfs:range xsd:boolean .

:multiRegion a owl:DatatypeProperty ;
    rdfs:label "multi region" ;
    rdfs:comment "Whether KMS key is multi-region" ;
    rdfs:domain :KMSKey ;
    rdfs:range xsd:boolean .

:nodeType a owl:DatatypeProperty ;
    rdfs:label "node type" ;
    rdfs:comment "Type of compute node" ;
    rdfs:domain :DatabaseResource ;
    rdfs:range xsd:string .

:numberOfNodes a owl:DatatypeProperty ;
    rdfs:label "number of nodes" ;
    rdfs:comment "Number of nodes in cluster" ;
    rdfs:domain :DatabaseResource ;
    rdfs:range xsd:integer .

:performanceMode a owl:DatatypeProperty ;
    rdfs:label "performance mode" ;
    rdfs:comment "EFS performance mode" ;
    rdfs:domain :EFSFileSystem ;
    rdfs:range xsd:string .

:port a owl:DatatypeProperty ;
    rdfs:label "port" ;
    rdfs:comment "Network port number" ;
    rdfs:domain :AWSResource ;
    rdfs:range xsd:integer .

:priceClass a owl:DatatypeProperty ;
    rdfs:label "price class" ;
    rdfs:comment "CloudFront price class" ;
    rdfs:domain :CloudFrontDistribution ;
    rdfs:range xsd:string .

:privateIpAddress a owl:DatatypeProperty ;
    rdfs:label "private IP address" ;
    rdfs:comment "Private IP address" ;
    rdfs:domain :NetworkInterface ;
    rdfs:range xsd:string .

:publicIP a owl:DatatypeProperty ;
    rdfs:label "public IP" ;
    rdfs:comment "Public IP address" ;
    rdfs:domain :ElasticIP ;
    rdfs:range xsd:string .

:ruleType a owl:DatatypeProperty ;
    rdfs:label "rule type" ;
    rdfs:comment "Security group rule type (ingress/egress)" ;
    rdfs:domain :SecurityGroupRule ;
    rdfs:range xsd:string .

:secretName a owl:DatatypeProperty ;
    rdfs:label "secret name" ;
    rdfs:comment "Name of the secret in Secrets Manager" ;
    rdfs:domain :SecretsManagerSecret ;
    rdfs:range xsd:string .

:serviceName a owl:DatatypeProperty ;
    rdfs:label "service name" ;
    rdfs:comment "Name of AWS service for VPC endpoint" ;
    rdfs:domain :VPCEndpoint ;
    rdfs:range xsd:string .

:snapshotType a owl:DatatypeProperty ;
    rdfs:label "snapshot type" ;
    rdfs:comment "Type of database snapshot" ;
    rdfs:domain :RDSSnapshot ;
    rdfs:range xsd:string .

:tableName a owl:DatatypeProperty ;
    rdfs:label "table name" ;
    rdfs:comment "DynamoDB table name" ;
    rdfs:domain :DynamoDBTable ;
    rdfs:range xsd:string .

:targetType a owl:DatatypeProperty ;
    rdfs:label "target type" ;
    rdfs:comment "Type of load balancer target" ;
    rdfs:domain :ELBv2TargetGroup ;
    rdfs:range xsd:string .

:throughputMode a owl:DatatypeProperty ;
    rdfs:label "throughput mode" ;
    rdfs:comment "EFS throughput mode" ;
    rdfs:domain :EFSFileSystem ;
    rdfs:range xsd:string .

:toPort a owl:DatatypeProperty ;
    rdfs:label "to port" ;
    rdfs:comment "Ending port number for security group rule" ;
    rdfs:domain :SecurityGroupRule ;
    rdfs:range xsd:integer .

:vpcEndpointType a owl:DatatypeProperty ;
    rdfs:label "VPC endpoint type" ;
    rdfs:comment "Type of VPC endpoint (Gateway/Interface)" ;
    rdfs:domain :VPCEndpoint ;
    rdfs:range xsd:string .

:AWSResource a owl:Class ;
    rdfs:label "AWS Resource" ;
    rdfs:comment "Base class for all AWS resources" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :arn ],
        prov:Entity ;
    owl:hasKey ( :arn ) .

### PROV-O alignment
# AWSResource -> prov:Entity is declared above. Model invocations (see AI Resources,
# below) are prov:Activity instances, giving the ontology a hook for provenance
# chains (wasGeneratedBy, used, wasAssociatedWith) without importing PROV-O's full
# axiomatization (avoids a network-fetch dependency at load time).

### AI Resources (Amazon Bedrock and related generative-AI services)

:AIResource a owl:Class ;
    rdfs:label "AI Resource" ;
    rdfs:comment "Base class for artificial intelligence and generative AI resources" ;
    rdfs:subClassOf :AWSResource ;
    owl:disjointWith :ComputeResource,
        :DatabaseResource,
        :IdentityResource,
        :IntegrationResource,
        :MonitoringResource,
        :NetworkingResource,
        :SecurityResource,
        :StorageResource .

:FoundationModel a owl:Class ;
    rdfs:label "Foundation Model" ;
    rdfs:comment "An Amazon Bedrock foundation model available for invocation" ;
    rdfs:subClassOf :AIResource .

:BedrockAgent a owl:Class ;
    rdfs:label "Bedrock Agent" ;
    rdfs:comment "An Amazon Bedrock agent that orchestrates foundation model calls with tools and knowledge bases" ;
    rdfs:subClassOf :AIResource .

:BedrockKnowledgeBase a owl:Class ;
    rdfs:label "Bedrock Knowledge Base" ;
    rdfs:comment "An Amazon Bedrock knowledge base providing retrieval-augmented generation over ingested data sources" ;
    rdfs:subClassOf :AIResource .

:BedrockGuardrail a owl:Class ;
    rdfs:label "Bedrock Guardrail" ;
    rdfs:comment "A content-filtering policy applied to Bedrock model invocations" ;
    rdfs:subClassOf :AIResource .

:BedrockDataSource a owl:Class ;
    rdfs:label "Bedrock Data Source" ;
    rdfs:comment "A data source (e.g. an S3 bucket) ingested into a Bedrock knowledge base" ;
    rdfs:subClassOf :AIResource .

:ModelInvocation a owl:Class ;
    rdfs:label "Model Invocation" ;
    rdfs:comment "A single invocation of a foundation model by a Bedrock agent" ;
    rdfs:subClassOf :AIResource,
        prov:Activity .

:invokesModel a owl:ObjectProperty ;
    rdfs:label "invokes model" ;
    rdfs:comment "Relates a Bedrock agent to a foundation model it may invoke" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :BedrockAgent ;
    rdfs:range :FoundationModel .

:usesKnowledgeBase a owl:ObjectProperty ;
    rdfs:label "uses knowledge base" ;
    rdfs:comment "Relates a Bedrock agent to a knowledge base it queries for retrieval-augmented generation" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :BedrockAgent ;
    rdfs:range :BedrockKnowledgeBase .

:ingestsDataSource a owl:ObjectProperty ;
    rdfs:label "ingests data source" ;
    rdfs:comment "Relates a Bedrock knowledge base to a data source it ingests" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :BedrockKnowledgeBase ;
    rdfs:range :BedrockDataSource .

:hasGuardrail a owl:ObjectProperty ;
    rdfs:label "has guardrail" ;
    rdfs:comment "Relates a Bedrock agent to a guardrail applied to its model invocations" ;
    rdfs:domain :BedrockAgent ;
    rdfs:range :BedrockGuardrail .

:invocationOf a owl:ObjectProperty ;
    rdfs:label "invocation of" ;
    rdfs:comment "Relates a model invocation to the foundation model that was invoked" ;
    rdfs:domain :ModelInvocation ;
    rdfs:range :FoundationModel .

:modelId a owl:DatatypeProperty ;
    rdfs:label "model ID" ;
    rdfs:comment "The Bedrock model identifier (e.g. a foundation model ID)" ;
    rdfs:domain :FoundationModel ;
    rdfs:range xsd:string .

:guardrailAction a owl:DatatypeProperty ;
    rdfs:label "guardrail action" ;
    rdfs:comment "The action a guardrail takes on a policy violation (e.g. BLOCK, ANONYMIZE)" ;
    rdfs:domain :BedrockGuardrail ;
    rdfs:range xsd:string .

### Identity Center resources (AWS IAM Identity Center / workforce SSO)

:IdentityCenterInstance a owl:Class ;
    rdfs:label "Identity Center Instance" ;
    rdfs:comment "An AWS IAM Identity Center instance providing centralized workforce access management across an AWS Organization" ;
    rdfs:subClassOf :IdentityResource .

:IdentityCenterPrincipal a owl:Class ;
    rdfs:label "Identity Center Principal" ;
    rdfs:comment "Abstract base class for Identity Center directory principals (users and groups)" ;
    rdfs:subClassOf :IdentityResource .

:IdentityCenterUser a owl:Class ;
    rdfs:label "Identity Center User" ;
    rdfs:comment "A user in the IAM Identity Center directory, distinct from an IAM user" ;
    rdfs:subClassOf :IdentityCenterPrincipal .

:IdentityCenterGroup a owl:Class ;
    rdfs:label "Identity Center Group" ;
    rdfs:comment "A group in the IAM Identity Center directory" ;
    rdfs:subClassOf :IdentityCenterPrincipal .

:PermissionSet a owl:Class ;
    rdfs:label "Permission Set" ;
    rdfs:comment "An IAM Identity Center permission set defining the permissions granted by an account assignment" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:minCardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :hasPolicy ],
        :IdentityResource .

:AccountAssignment a owl:Class ;
    rdfs:label "Account Assignment" ;
    rdfs:comment "Assigns an Identity Center principal to an AWS account via a permission set" ;
    rdfs:subClassOf :IdentityResource .

:hasPermissionSet a owl:ObjectProperty ;
    rdfs:label "has permission set" ;
    rdfs:comment "Relates an Identity Center instance to a permission set it defines" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :IdentityCenterInstance ;
    rdfs:range :PermissionSet .

:assignsPermissionSet a owl:ObjectProperty ;
    rdfs:label "assigns permission set" ;
    rdfs:comment "Relates an account assignment to the permission set it grants" ;
    rdfs:domain :AccountAssignment ;
    rdfs:range :PermissionSet .

:assignsPrincipal a owl:ObjectProperty ;
    rdfs:label "assigns principal" ;
    rdfs:comment "Relates an account assignment to the Identity Center principal it applies to" ;
    rdfs:domain :AccountAssignment ;
    rdfs:range :IdentityCenterPrincipal .

:assignsToAccount a owl:ObjectProperty ;
    rdfs:label "assigns to account" ;
    rdfs:comment "Relates an account assignment to the target AWS account" ;
    rdfs:domain :AccountAssignment ;
    rdfs:range :AWSAccount .

### Property hierarchy refinements
# Ties existing specific relationships to the generic cross-cutting properties
# (contains/uses/dependsOn) so transitive/general-purpose queries over the
# generic properties also pick up these specific ones.

:podRunsOn rdfs:subPropertyOf :dependsOn .

:runsOnCluster rdfs:subPropertyOf :dependsOn .

:usesContainerImage rdfs:subPropertyOf :uses .

:hasNodeGroup rdfs:subPropertyOf :contains .

:hasTaskDefinition rdfs:subPropertyOf :contains .

:attachedTo rdfs:subPropertyOf :dependsOn .

:encryptedWith rdfs:subPropertyOf :uses .

:routesTrafficThrough rdfs:subPropertyOf :dependsOn .

### SKOS concept scheme: AWS resource categories
# Orthogonal to the OWL class hierarchy (which uses owl:disjointWith for strict
# partitioning): a thesaurus-style, browsable taxonomy of the top-level resource
# categories. Each category class is punned as a skos:Concept (legal under OWL 2
# DL's class/individual punning) so the same IRI serves both roles.

:AWSResourceCategoryScheme a skos:ConceptScheme ;
    rdfs:label "AWS Resource Category Scheme" ;
    skos:prefLabel "AWS Resource Category Scheme" .

:ComputeResource a skos:Concept ;
    skos:prefLabel "Compute Resource" ;
    skos:inScheme :AWSResourceCategoryScheme ;
    skos:topConceptOf :AWSResourceCategoryScheme .

:StorageResource a skos:Concept ;
    skos:prefLabel "Storage Resource" ;
    skos:inScheme :AWSResourceCategoryScheme ;
    skos:topConceptOf :AWSResourceCategoryScheme .

:NetworkingResource a skos:Concept ;
    skos:prefLabel "Networking Resource" ;
    skos:inScheme :AWSResourceCategoryScheme ;
    skos:topConceptOf :AWSResourceCategoryScheme .

:IdentityResource a skos:Concept ;
    skos:prefLabel "Identity Resource" ;
    skos:inScheme :AWSResourceCategoryScheme ;
    skos:topConceptOf :AWSResourceCategoryScheme .

:MonitoringResource a skos:Concept ;
    skos:prefLabel "Monitoring Resource" ;
    skos:inScheme :AWSResourceCategoryScheme ;
    skos:topConceptOf :AWSResourceCategoryScheme .

:IntegrationResource a skos:Concept ;
    skos:prefLabel "Integration Resource" ;
    skos:inScheme :AWSResourceCategoryScheme ;
    skos:topConceptOf :AWSResourceCategoryScheme .

:DatabaseResource a skos:Concept ;
    skos:prefLabel "Database Resource" ;
    skos:inScheme :AWSResourceCategoryScheme ;
    skos:topConceptOf :AWSResourceCategoryScheme .

:SecurityResource a skos:Concept ;
    skos:prefLabel "Security Resource" ;
    skos:inScheme :AWSResourceCategoryScheme ;
    skos:topConceptOf :AWSResourceCategoryScheme .

:AIResource a skos:Concept ;
    skos:prefLabel "AI Resource" ;
    skos:inScheme :AWSResourceCategoryScheme ;
    skos:topConceptOf :AWSResourceCategoryScheme .

:AWSResourceCategoryScheme skos:hasTopConcept :ComputeResource,
        :StorageResource,
        :NetworkingResource,
        :IdentityResource,
        :MonitoringResource,
        :IntegrationResource,
        :DatabaseResource,
        :SecurityResource,
        :AIResource .


### AWS Organizations and Control Tower

:Organization a owl:Class ;
    rdfs:label "Organization" ;
    rdfs:comment "The root container for an AWS Organization, grouping member accounts under centralized management" ;
    rdfs:subClassOf :IdentityResource .

:OrganizationalUnit a owl:Class ;
    rdfs:label "Organizational Unit" ;
    rdfs:comment "A container within an AWS Organization used to group accounts for policy application" ;
    rdfs:subClassOf :IdentityResource .

:ControlTowerLandingZone a owl:Class ;
    rdfs:label "Control Tower Landing Zone" ;
    rdfs:comment "An AWS Control Tower landing zone governing an AWS Organization with pre-configured guardrails" ;
    rdfs:subClassOf :IdentityResource .

:hasOrganizationalUnit a owl:ObjectProperty ;
    rdfs:label "has organizational unit" ;
    rdfs:comment "Relates an Organization to an organizational unit it contains" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :Organization ;
    rdfs:range :OrganizationalUnit .

:hasAccount a owl:ObjectProperty ;
    rdfs:label "has account" ;
    rdfs:comment "Relates an Organization to a member account" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :Organization ;
    rdfs:range :AWSAccount .

:belongsToOrganizationalUnit a owl:ObjectProperty ;
    rdfs:label "belongs to organizational unit" ;
    rdfs:comment "Relates an AWS account to the organizational unit that contains it" ;
    rdfs:domain :AWSAccount ;
    rdfs:range :OrganizationalUnit .

:governsOrganization a owl:ObjectProperty ;
    rdfs:label "governs organization" ;
    rdfs:comment "Relates a Control Tower landing zone to the Organization it governs" ;
    rdfs:subPropertyOf :manages ;
    rdfs:domain :ControlTowerLandingZone ;
    rdfs:range :Organization .

### Amazon Cognito

:CognitoUserPool a owl:Class ;
    rdfs:label "Cognito User Pool" ;
    rdfs:comment "An Amazon Cognito user directory for application end-user sign-up and sign-in" ;
    rdfs:subClassOf :IdentityResource .

:CognitoUserPoolClient a owl:Class ;
    rdfs:label "Cognito User Pool Client" ;
    rdfs:comment "An application client configured against a Cognito user pool" ;
    rdfs:subClassOf :IdentityResource .

:CognitoIdentityPool a owl:Class ;
    rdfs:label "Cognito Identity Pool" ;
    rdfs:comment "An Amazon Cognito identity pool that federates identity providers to grant temporary AWS credentials" ;
    rdfs:subClassOf :IdentityResource .

:hasUserPoolClient a owl:ObjectProperty ;
    rdfs:label "has user pool client" ;
    rdfs:comment "Relates a Cognito user pool to an application client configured against it" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :CognitoUserPool ;
    rdfs:range :CognitoUserPoolClient .

:federatesUserPool a owl:ObjectProperty ;
    rdfs:label "federates user pool" ;
    rdfs:comment "Relates a Cognito identity pool to a user pool it federates as an identity provider" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :CognitoIdentityPool ;
    rdfs:range :CognitoUserPool .

### GuardDuty and Security Hub

:GuardDutyDetector a owl:Class ;
    rdfs:label "GuardDuty Detector" ;
    rdfs:comment "An Amazon GuardDuty detector monitoring an account and region for threats" ;
    rdfs:subClassOf :SecurityResource .

:GuardDutyFinding a owl:Class ;
    rdfs:label "GuardDuty Finding" ;
    rdfs:comment "A threat detection finding generated by a GuardDuty detector" ;
    rdfs:subClassOf :SecurityResource .

:SecurityHubHub a owl:Class ;
    rdfs:label "Security Hub" ;
    rdfs:comment "The AWS Security Hub resource enabling centralized security finding aggregation for an account and region" ;
    rdfs:subClassOf :SecurityResource .

:SecurityHubStandardsSubscription a owl:Class ;
    rdfs:label "Security Hub Standards Subscription" ;
    rdfs:comment "A subscription of a Security Hub account to a compliance standard (e.g. CIS AWS Foundations)" ;
    rdfs:subClassOf :SecurityResource .

:hasFinding a owl:ObjectProperty ;
    rdfs:label "has finding" ;
    rdfs:comment "Relates a GuardDuty detector to a finding it generated" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :GuardDutyDetector ;
    rdfs:range :GuardDutyFinding .

:aggregatesFinding a owl:ObjectProperty ;
    rdfs:label "aggregates finding" ;
    rdfs:comment "Relates Security Hub to a finding it aggregates from another detective service (e.g. GuardDuty)" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :SecurityHubHub ;
    rdfs:range :GuardDutyFinding .

:hasStandardsSubscription a owl:ObjectProperty ;
    rdfs:label "has standards subscription" ;
    rdfs:comment "Relates Security Hub to a compliance standard it is subscribed to" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :SecurityHubHub ;
    rdfs:range :SecurityHubStandardsSubscription .

:findingSeverity a owl:DatatypeProperty ;
    rdfs:label "finding severity" ;
    rdfs:comment "GuardDuty finding severity score (0.1-8.9)" ;
    rdfs:domain :GuardDutyFinding ;
    rdfs:range xsd:decimal .

:findingType a owl:DatatypeProperty ;
    rdfs:label "finding type" ;
    rdfs:comment "GuardDuty finding type identifier (e.g. UnauthorizedAccess:EC2/SSHBruteForce)" ;
    rdfs:domain :GuardDutyFinding ;
    rdfs:range xsd:string .

:standardName a owl:DatatypeProperty ;
    rdfs:label "standard name" ;
    rdfs:comment "The name of the compliance standard subscribed to (e.g. cis-aws-foundations-benchmark)" ;
    rdfs:domain :SecurityHubStandardsSubscription ;
    rdfs:range xsd:string .

### Amazon SageMaker (extends :AIResource, established in the Bedrock/GenAI additions)

:SageMakerNotebookInstance a owl:Class ;
    rdfs:label "SageMaker Notebook Instance" ;
    rdfs:comment "A managed Jupyter notebook instance for SageMaker model development" ;
    rdfs:subClassOf :AIResource .

:SageMakerModel a owl:Class ;
    rdfs:label "SageMaker Model" ;
    rdfs:comment "A trained SageMaker model artifact ready for deployment" ;
    rdfs:subClassOf :AIResource .

:SageMakerEndpoint a owl:Class ;
    rdfs:label "SageMaker Endpoint" ;
