:RouteTable a owl:Class ;
    rdfs:label "Route Table" ;
    rdfs:comment "A VPC route table" ;
    rdfs:subClassOf :NetworkingResource .

:S3Bucket a owl:Class ;
    rdfs:label "S3 Bucket" ;
    rdfs:comment "An Amazon S3 storage bucket" ;
