### AWS Transit Gateway

:TransitGateway a owl:Class ;
    rdfs:label "Transit Gateway" ;
    rdfs:comment "A network transit hub connecting VPCs and on-premises networks" ;
    rdfs:subClassOf :NetworkingResource .

:TransitGatewayAttachment a owl:Class ;
    rdfs:label "Transit Gateway Attachment" ;
    rdfs:comment "Attaches a VPC, VPN, Direct Connect gateway, or peering connection to a Transit Gateway" ;
    rdfs:subClassOf :NetworkingResource .

:TransitGatewayRouteTable a owl:Class ;
    rdfs:label "Transit Gateway Route Table" ;
    rdfs:comment "A route table controlling traffic between Transit Gateway attachments" ;
    rdfs:subClassOf :NetworkingResource .

:hasAttachment a owl:ObjectProperty ;
    rdfs:label "has attachment" ;
    rdfs:comment "Relates a Transit Gateway to an attachment it manages" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :TransitGateway ;
    rdfs:range :TransitGatewayAttachment .

:attachesVPC a owl:ObjectProperty ;
    rdfs:label "attaches VPC" ;
    rdfs:comment "Relates a Transit Gateway attachment to the VPC it connects" ;
    rdfs:domain :TransitGatewayAttachment ;
    rdfs:range :VPC .

:hasRouteTable a owl:ObjectProperty ;
    rdfs:label "has route table" ;
    rdfs:comment "Relates a Transit Gateway to a route table it manages" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :TransitGateway ;
    rdfs:range :TransitGatewayRouteTable .

### Amazon ElastiCache

:ElastiCacheCluster a owl:Class ;
    rdfs:label "ElastiCache Cluster" ;
    rdfs:comment "An Amazon ElastiCache cluster (a Redis or Memcached cache node group)" ;
    rdfs:subClassOf :DatabaseResource .

:ElastiCacheReplicationGroup a owl:Class ;
    rdfs:label "ElastiCache Replication Group" ;
    rdfs:comment "An ElastiCache for Redis replication group providing multi-AZ failover across clusters" ;
    rdfs:subClassOf :DatabaseResource .

:hasCacheCluster a owl:ObjectProperty ;
    rdfs:label "has cache cluster" ;
    rdfs:comment "Relates an ElastiCache replication group to a cluster (shard) it comprises" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :ElastiCacheReplicationGroup ;
    rdfs:range :ElastiCacheCluster .

:engineType a owl:DatatypeProperty ;
    rdfs:label "engine type" ;
    rdfs:comment "The cache engine (redis or memcached)" ;
    rdfs:domain :ElastiCacheCluster ;
    rdfs:range xsd:string .

:cacheNodeType a owl:DatatypeProperty ;
    rdfs:label "cache node type" ;
    rdfs:comment "The compute and memory capacity class of a cache node (e.g. cache.r6g.large)" ;
    rdfs:domain :ElastiCacheCluster ;
    rdfs:range xsd:string .

### AWS Systems Manager

:SSMParameter a owl:Class ;
    rdfs:label "SSM Parameter" ;
    rdfs:comment "A Systems Manager Parameter Store parameter" ;
    rdfs:subClassOf :MonitoringResource .

:SSMDocument a owl:Class ;
    rdfs:label "SSM Document" ;
    rdfs:comment "A Systems Manager automation or command document" ;
    rdfs:subClassOf :MonitoringResource .

:SSMPatchBaseline a owl:Class ;
    rdfs:label "SSM Patch Baseline" ;
    rdfs:comment "A Systems Manager patch baseline defining approved patches for managed instances" ;
    rdfs:subClassOf :MonitoringResource .

:governsPatchingFor a owl:ObjectProperty ;
    rdfs:label "governs patching for" ;
    rdfs:comment "Relates an SSM patch baseline to a resource whose patching it governs" ;
    rdfs:subPropertyOf :manages ;
    rdfs:domain :SSMPatchBaseline ;
    rdfs:range :AWSResource .

### Analytics Resources (AWS Glue, Athena, Kinesis, EMR, OpenSearch Service)

:AnalyticsResource a owl:Class ;
    rdfs:label "Analytics Resource" ;
    rdfs:comment "Base class for data analytics, ETL, streaming, and search-analytics resources" ;
    rdfs:subClassOf :AWSResource ;
    owl:disjointWith :AIResource,
        :ComputeResource,
        :DatabaseResource,
        :IdentityResource,
        :IntegrationResource,
        :MonitoringResource,
        :NetworkingResource,
        :SecurityResource,
        :StorageResource .

### AWS Glue

:GlueDatabase a owl:Class ;
    rdfs:label "Glue Database" ;
    rdfs:comment "A Glue Data Catalog database, a metadata container for tables" ;
    rdfs:subClassOf :AnalyticsResource .

:GlueTable a owl:Class ;
    rdfs:label "Glue Table" ;
    rdfs:comment "A Glue Data Catalog table describing the schema and location of a dataset" ;
    rdfs:subClassOf :AnalyticsResource .

:GlueCrawler a owl:Class ;
    rdfs:label "Glue Crawler" ;
    rdfs:comment "A Glue crawler that inspects data sources and populates the Data Catalog" ;
    rdfs:subClassOf :AnalyticsResource .

:GlueJob a owl:Class ;
    rdfs:label "Glue Job" ;
    rdfs:comment "A Glue ETL job that transforms data between sources" ;
    rdfs:subClassOf :AnalyticsResource .

:hasTable a owl:ObjectProperty ;
    rdfs:label "has table" ;
    rdfs:comment "Relates a Glue database to a table it contains" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :GlueDatabase ;
    rdfs:range :GlueTable .

:discoversTable a owl:ObjectProperty ;
    rdfs:label "discovers table" ;
    rdfs:comment "Relates a Glue crawler to a table it discovered and catalogued" ;
    rdfs:subPropertyOf :manages ;
    rdfs:domain :GlueCrawler ;
    rdfs:range :GlueTable .

:readsFromTable a owl:ObjectProperty ;
    rdfs:label "reads from table" ;
    rdfs:comment "Relates a Glue ETL job to a table it reads as a source" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :GlueJob ;
    rdfs:range :GlueTable .

:dataFormat a owl:DatatypeProperty ;
    rdfs:label "data format" ;
    rdfs:comment "The storage format of a dataset (e.g. parquet, csv, json)" ;
    rdfs:domain :GlueTable ;
    rdfs:range xsd:string .

### Amazon Athena

:AthenaWorkGroup a owl:Class ;
    rdfs:label "Athena WorkGroup" ;
    rdfs:comment "An Athena workgroup grouping queries under shared settings and cost controls" ;
    rdfs:subClassOf :AnalyticsResource .

:AthenaDataCatalog a owl:Class ;
    rdfs:label "Athena Data Catalog" ;
    rdfs:comment "A data source catalog registered with Athena (e.g. the AWS Glue Data Catalog)" ;
    rdfs:subClassOf :AnalyticsResource .

:AthenaQueryExecution a owl:Class ;
    rdfs:label "Athena Query Execution" ;
    rdfs:comment "A single execution of a SQL query against Athena" ;
    rdfs:subClassOf :AnalyticsResource,
        prov:Activity .

:runsInWorkGroup a owl:ObjectProperty ;
    rdfs:label "runs in workgroup" ;
    rdfs:comment "Relates an Athena query execution to the workgroup it ran under" ;
    rdfs:subPropertyOf :dependsOn ;
    rdfs:domain :AthenaQueryExecution ;
    rdfs:range :AthenaWorkGroup .

:queriesTable a owl:ObjectProperty ;
    rdfs:label "queries table" ;
    rdfs:comment "Relates an Athena query execution to a Glue table it queried" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :AthenaQueryExecution ;
    rdfs:range :GlueTable .

:sqlQuery a owl:DatatypeProperty ;
    rdfs:label "SQL query" ;
    rdfs:comment "The SQL text of an Athena query execution" ;
    rdfs:domain :AthenaQueryExecution ;
    rdfs:range xsd:string .

### Amazon Kinesis

:KinesisStream a owl:Class ;
    rdfs:label "Kinesis Stream" ;
    rdfs:comment "A Kinesis Data Stream for real-time data ingestion" ;
    rdfs:subClassOf :AnalyticsResource .

:KinesisFirehoseDeliveryStream a owl:Class ;
    rdfs:label "Kinesis Firehose Delivery Stream" ;
    rdfs:comment "A Kinesis Data Firehose delivery stream that loads streaming data into a destination" ;
    rdfs:subClassOf :AnalyticsResource .

:KinesisAnalyticsApplication a owl:Class ;
    rdfs:label "Kinesis Analytics Application" ;
    rdfs:comment "A Kinesis Data Analytics (Managed Service for Apache Flink) application processing a stream" ;
    rdfs:subClassOf :AnalyticsResource .

:sourceStream a owl:ObjectProperty ;
    rdfs:label "source stream" ;
    rdfs:comment "Relates a Firehose delivery stream to the Kinesis stream it reads from" ;
    rdfs:subPropertyOf :dependsOn ;
    rdfs:domain :KinesisFirehoseDeliveryStream ;
    rdfs:range :KinesisStream .

:analyzesStream a owl:ObjectProperty ;
    rdfs:label "analyzes stream" ;
    rdfs:comment "Relates a Kinesis Analytics application to the stream it processes" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :KinesisAnalyticsApplication ;
    rdfs:range :KinesisStream .

:shardCount a owl:DatatypeProperty ;
    rdfs:label "shard count" ;
    rdfs:comment "The number of shards provisioned for a Kinesis stream" ;
    rdfs:domain :KinesisStream ;
    rdfs:range xsd:integer .

### Amazon EMR

:EMRCluster a owl:Class ;
    rdfs:label "EMR Cluster" ;
    rdfs:comment "A managed Hadoop/Spark cluster running on Amazon EMR" ;
    rdfs:subClassOf :AnalyticsResource .

:EMRStep a owl:Class ;
    rdfs:label "EMR Step" ;
    rdfs:comment "A processing step (job) submitted to an EMR cluster" ;
    rdfs:subClassOf :AnalyticsResource,
        prov:Activity .

:EMRNotebook a owl:Class ;
    rdfs:label "EMR Notebook" ;
    rdfs:comment "An EMR Studio/Notebook editor for interactive analytics on an EMR cluster" ;
    rdfs:subClassOf :AnalyticsResource .

:hasStep a owl:ObjectProperty ;
    rdfs:label "has step" ;
    rdfs:comment "Relates an EMR cluster to a step submitted to it" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :EMRCluster ;
    rdfs:range :EMRStep .

:processesTable a owl:ObjectProperty ;
    rdfs:label "processes table" ;
    rdfs:comment "Relates an EMR step to a Glue table it reads or writes via the Hive metastore" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :EMRStep ;
    rdfs:range :GlueTable .

:instanceCount a owl:DatatypeProperty ;
    rdfs:label "instance count" ;
    rdfs:comment "The number of EC2 instances (nodes) in an EMR cluster" ;
    rdfs:domain :EMRCluster ;
    rdfs:range xsd:integer .

### Amazon OpenSearch Service

:OpenSearchDomain a owl:Class ;
    rdfs:label "OpenSearch Domain" ;
    rdfs:comment "A managed Amazon OpenSearch Service domain (search and analytics cluster)" ;
    rdfs:subClassOf :AnalyticsResource .

:OpenSearchIndex a owl:Class ;
    rdfs:label "OpenSearch Index" ;
    rdfs:comment "A logical index within an OpenSearch domain" ;
    rdfs:subClassOf :AnalyticsResource .

:hasIndex a owl:ObjectProperty ;
    rdfs:label "has index" ;
    rdfs:comment "Relates an OpenSearch domain to an index it hosts" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :OpenSearchDomain ;
    rdfs:range :OpenSearchIndex .

:deliversToDomain a owl:ObjectProperty ;
    rdfs:label "delivers to domain" ;
    rdfs:comment "Relates a Firehose delivery stream to the OpenSearch domain it delivers records into" ;
    rdfs:subPropertyOf :dependsOn ;
    rdfs:domain :KinesisFirehoseDeliveryStream ;
    rdfs:range :OpenSearchDomain .

:searchEngineVersion a owl:DatatypeProperty ;
    rdfs:label "search engine version" ;
    rdfs:comment "The OpenSearch or Elasticsearch engine version running on a domain" ;
    rdfs:domain :OpenSearchDomain ;
    rdfs:range xsd:string .

### AWS WAF

:WAFWebACL a owl:Class ;
    rdfs:label "WAF Web ACL" ;
    rdfs:comment "An AWS WAF web access control list that filters web requests based on configurable rules" ;
    rdfs:subClassOf :SecurityResource .

:WAFRuleGroup a owl:Class ;
    rdfs:label "WAF Rule Group" ;
    rdfs:comment "A reusable collection of AWS WAF rules that can be referenced by one or more web ACLs" ;
    rdfs:subClassOf :SecurityResource .

:WAFIPSet a owl:Class ;
    rdfs:label "WAF IP Set" ;
    rdfs:comment "An AWS WAF IP set defining a list of IP addresses or CIDR ranges for allow/block matching" ;
    rdfs:subClassOf :SecurityResource .

:hasRuleGroup a owl:ObjectProperty ;
    rdfs:label "has rule group" ;
    rdfs:comment "Relates a WAF web ACL to a rule group it evaluates against incoming requests" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :WAFWebACL ;
    rdfs:range :WAFRuleGroup .

:referencesIPSet a owl:ObjectProperty ;
    rdfs:label "references IP set" ;
    rdfs:comment "Relates a WAF rule group to an IP set it references in a match condition" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :WAFRuleGroup ;
    rdfs:range :WAFIPSet .

:scope a owl:DatatypeProperty ;
    rdfs:label "scope" ;
    rdfs:comment "The WAF scope a web ACL is associated with (REGIONAL or CLOUDFRONT)" ;
    rdfs:domain :WAFWebACL ;
    rdfs:range xsd:string .

:defaultAction a owl:DatatypeProperty ;
    rdfs:label "default action" ;
    rdfs:comment "The action (ALLOW or BLOCK) a WAF web ACL takes when no rule matches a request" ;
    rdfs:domain :WAFWebACL ;
    rdfs:range xsd:string .

### AWS Config

:ConfigRule a owl:Class ;
    rdfs:label "Config Rule" ;
    rdfs:comment "An AWS Config rule that evaluates whether resource configurations comply with a desired state" ;
    rdfs:subClassOf :MonitoringResource .

:ConfigurationRecorder a owl:Class ;
    rdfs:label "Configuration Recorder" ;
    rdfs:comment "The AWS Config configuration recorder that tracks resource configuration changes for an account and region" ;
    rdfs:subClassOf :MonitoringResource .

:ConfigConformancePack a owl:Class ;
    rdfs:label "Config Conformance Pack" ;
    rdfs:comment "A Config conformance pack bundling a collection of Config rules and remediation actions for a common compliance framework" ;
    rdfs:subClassOf :MonitoringResource .

:evaluatesComplianceOf a owl:ObjectProperty ;
    rdfs:label "evaluates compliance of" ;
    rdfs:comment "Relates a Config rule to the AWS resource whose configuration it evaluates for compliance" ;
    rdfs:domain :ConfigRule ;
    rdfs:range :AWSResource .

:hasConfigRule a owl:ObjectProperty ;
    rdfs:label "has config rule" ;
    rdfs:comment "Relates a Config conformance pack to a rule it bundles" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :ConfigConformancePack ;
    rdfs:range :ConfigRule .

### AWS Direct Connect

:DirectConnectGateway a owl:Class ;
    rdfs:label "Direct Connect Gateway" ;
    rdfs:comment "A global AWS Direct Connect gateway connecting Direct Connect virtual interfaces to VPCs across regions via Transit Gateway or virtual private gateway" ;
    rdfs:subClassOf :NetworkingResource .

:DirectConnectConnection a owl:Class ;
    rdfs:label "Direct Connect Connection" ;
    rdfs:comment "A dedicated physical network connection between an AWS Direct Connect location and an on-premises network" ;
    rdfs:subClassOf :NetworkingResource .

:DirectConnectVirtualInterface a owl:Class ;
    rdfs:label "Direct Connect Virtual Interface" ;
    rdfs:comment "A private, public, or transit virtual interface provisioned over a Direct Connect connection" ;
    rdfs:subClassOf :NetworkingResource .

:hasVirtualInterface a owl:ObjectProperty ;
    rdfs:label "has virtual interface" ;
    rdfs:comment "Relates a Direct Connect connection to a virtual interface provisioned over it" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :DirectConnectConnection ;
    rdfs:range :DirectConnectVirtualInterface .

:associatedWithGateway a owl:ObjectProperty ;
    rdfs:label "associated with gateway" ;
    rdfs:comment "Relates a transit virtual interface to the Direct Connect gateway it is associated with" ;
    rdfs:subPropertyOf :dependsOn ;
    rdfs:domain :DirectConnectVirtualInterface ;
    rdfs:range :DirectConnectGateway .

:attachesDirectConnectGateway a owl:ObjectProperty ;
    rdfs:label "attaches Direct Connect gateway" ;
    rdfs:comment "Relates a Transit Gateway attachment to the Direct Connect gateway it connects" ;
    rdfs:domain :TransitGatewayAttachment ;
    rdfs:range :DirectConnectGateway .

:connectionBandwidth a owl:DatatypeProperty ;
    rdfs:label "connection bandwidth" ;
    rdfs:comment "The provisioned bandwidth of a Direct Connect connection (e.g. 1Gbps, 10Gbps)" ;
    rdfs:domain :DirectConnectConnection ;
    rdfs:range xsd:string .

:virtualInterfaceType a owl:DatatypeProperty ;
    rdfs:label "virtual interface type" ;
    rdfs:comment "The Direct Connect virtual interface type (private, public, or transit)" ;
    rdfs:domain :DirectConnectVirtualInterface ;
    rdfs:range xsd:string .

### Management Resources (AWS CloudFormation, AWS CodePipeline)

:DeploymentResource a owl:Class ;
    rdfs:label "Deployment Resource" ;
    rdfs:comment "Base class for infrastructure-as-code provisioning and continuous-delivery pipeline resources" ;
    rdfs:subClassOf :AWSResource ;
    owl:disjointWith :AIResource,
        :AnalyticsResource,
        :ComputeResource,
        :DatabaseResource,
        :IdentityResource,
        :IntegrationResource,
        :MonitoringResource,
        :NetworkingResource,
        :SecurityResource,
        :StorageResource .

:CloudFormationStack a owl:Class ;
    rdfs:label "CloudFormation Stack" ;
    rdfs:comment "A CloudFormation stack representing a collection of AWS resources managed as a single provisioning unit" ;
    rdfs:subClassOf :DeploymentResource .

:CloudFormationStackSet a owl:Class ;
    rdfs:label "CloudFormation StackSet" ;
    rdfs:comment "A CloudFormation StackSet that deploys a common stack template across multiple accounts and regions" ;
    rdfs:subClassOf :DeploymentResource .

:CloudFormationChangeSet a owl:Class ;
    rdfs:label "CloudFormation Change Set" ;
    rdfs:comment "A CloudFormation change set previewing proposed changes to a stack before they are executed" ;
    rdfs:subClassOf :DeploymentResource .

:CodePipelinePipeline a owl:Class ;
    rdfs:label "CodePipeline Pipeline" ;
    rdfs:comment "An AWS CodePipeline continuous-delivery pipeline that orchestrates build, test, and deploy stages" ;
    rdfs:subClassOf :DeploymentResource .

:CodePipelineStage a owl:Class ;
    rdfs:label "CodePipeline Stage" ;
    rdfs:comment "A named stage within a CodePipeline pipeline (e.g. Source, Build, Deploy) executing one or more actions in sequence" ;
    rdfs:subClassOf :DeploymentResource .

:hasChangeSet a owl:ObjectProperty ;
    rdfs:label "has change set" ;
    rdfs:comment "Relates a CloudFormation stack to a pending change set proposing updates to it" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :CloudFormationStack ;
    rdfs:range :CloudFormationChangeSet .

:hasStackInstance a owl:ObjectProperty ;
    rdfs:label "has stack instance" ;
    rdfs:comment "Relates a CloudFormation StackSet to a stack instance it deploys into a target account and region" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :CloudFormationStackSet ;
    rdfs:range :CloudFormationStack .

:provisionsResource a owl:ObjectProperty ;
    rdfs:label "provisions resource" ;
    rdfs:comment "Relates a CloudFormation stack to an AWS resource it provisions and manages" ;
    rdfs:subPropertyOf :manages ;
    rdfs:domain :CloudFormationStack ;
    rdfs:range :AWSResource .

:hasPipelineStage a owl:ObjectProperty ;
    rdfs:label "has pipeline stage" ;
    rdfs:comment "Relates a CodePipeline pipeline to a stage it executes in sequence" ;
    rdfs:subPropertyOf :contains ;
    rdfs:domain :CodePipelinePipeline ;
    rdfs:range :CodePipelineStage .

:deploysStack a owl:ObjectProperty ;
    rdfs:label "deploys stack" ;
    rdfs:comment "Relates a CodePipeline deploy stage to the CloudFormation stack it deploys" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :CodePipelineStage ;
    rdfs:range :CloudFormationStack .

:stackStatus a owl:DatatypeProperty ;
    rdfs:label "stack status" ;
    rdfs:comment "The current status of a CloudFormation stack (e.g. CREATE_COMPLETE, UPDATE_IN_PROGRESS, ROLLBACK_COMPLETE)" ;
    rdfs:domain :CloudFormationStack ;
    rdfs:range xsd:string .

:stageOrder a owl:DatatypeProperty ;
    rdfs:label "stage order" ;
    rdfs:comment "The sequential position of a stage within its pipeline" ;
    rdfs:domain :CodePipelineStage ;
    rdfs:range xsd:integer .
