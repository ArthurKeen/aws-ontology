    rdfs:subClassOf :AIResource .

:SageMakerTrainingJob a owl:Class ;
    rdfs:label "SageMaker Training Job" ;
    rdfs:comment "A SageMaker job that trains a model on a dataset, producing a model artifact" ;
    rdfs:subClassOf :AIResource,
        prov:Activity .

:deploysModel a owl:ObjectProperty ;
    rdfs:label "deploys model" ;
    rdfs:comment "Relates a SageMaker endpoint to the model it serves" ;
    rdfs:subPropertyOf :uses ;
    rdfs:domain :SageMakerEndpoint ;
    rdfs:range :SageMakerModel .

:producesModel a owl:ObjectProperty ;
    rdfs:label "produces model" ;
    rdfs:comment "Relates a SageMaker training job to the model artifact it produces" ;
    rdfs:domain :SageMakerTrainingJob ;
    rdfs:range :SageMakerModel .

