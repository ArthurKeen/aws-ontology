    :environment "production" .

:SessionCacheCluster001 rdf:type :ElastiCacheCluster ;
    rdfs:label "Session Cache Cluster 001" ;
    :arn "arn:aws:elasticache:us-east-1:123456789012:cluster:session-cache-001" ;
    :engineType "redis"^^xsd:string ;
    :cacheNodeType "cache.r6g.large"^^xsd:string ;
    :environment "production" .

# Examples for AWS Systems Manager
:DatabasePasswordParameter rdf:type :SSMParameter ;
    rdfs:label "Database Password Parameter" ;
    :arn "arn:aws:ssm:us-east-1:123456789012:parameter/prod/database/password" ;
    :environment "production" .

:PatchLinuxDocument rdf:type :SSMDocument ;
    rdfs:label "Patch Linux Document" ;
    :arn "arn:aws:ssm:us-east-1:123456789012:document/AWS-RunPatchBaseline" ;
    :environment "production" .

:ProdPatchBaseline rdf:type :SSMPatchBaseline ;
    rdfs:label "Production Patch Baseline" ;
    :arn "arn:aws:ssm:us-east-1:123456789012:patchbaseline/pb-0123456789abcdef0" ;
    :governsPatchingFor :WebServerInstance ;
    :environment "production" .

# Examples for AWS Analytics (Glue, Athena, Kinesis, EMR, OpenSearch) — a
# clickstream analytics pipeline showing real cross-service relationships:
# Kinesis Stream feeds both Firehose (-> OpenSearch for search, and via
# crawler -> Glue Catalog for batch analytics) and Kinesis Analytics
# (real-time metrics); the cataloged table is then queried by Athena, an
# EMR cluster, and a Glue ETL job.

:ClickstreamKinesisStream rdf:type :KinesisStream ;
    rdfs:label "Clickstream Kinesis Stream" ;
    :arn "arn:aws:kinesis:us-east-1:123456789012:stream/clickstream-events" ;
    :shardCount "4"^^xsd:integer ;
    :environment "production" .

:ClickstreamFirehose rdf:type :KinesisFirehoseDeliveryStream ;
    rdfs:label "Clickstream Firehose Delivery Stream" ;
    :arn "arn:aws:firehose:us-east-1:123456789012:deliverystream/clickstream-delivery" ;
    :sourceStream :ClickstreamKinesisStream ;
    :deliversToDomain :ClickstreamSearchDomain ;
    :environment "production" .

:ClickstreamAnalyticsApp rdf:type :KinesisAnalyticsApplication ;
    rdfs:label "Clickstream Real-Time Metrics Application" ;
    :arn "arn:aws:kinesisanalytics:us-east-1:123456789012:application/clickstream-realtime-metrics" ;
    :analyzesStream :ClickstreamKinesisStream ;
    :environment "production" .

:AnalyticsDatabase rdf:type :GlueDatabase ;
    rdfs:label "Analytics Database" ;
    :arn "arn:aws:glue:us-east-1:123456789012:database/analytics_db" ;
    :hasTable :ClickstreamTable ;
    :environment "production" .

:ClickstreamTable rdf:type :GlueTable ;
    rdfs:label "Clickstream Events Table" ;
    :arn "arn:aws:glue:us-east-1:123456789012:table/analytics_db/clickstream_events" ;
    :dataFormat "parquet"^^xsd:string ;
    :environment "production" .

:ClickstreamCrawler rdf:type :GlueCrawler ;
    rdfs:label "Clickstream Crawler" ;
    :arn "arn:aws:glue:us-east-1:123456789012:crawler/clickstream-crawler" ;
    :discoversTable :ClickstreamTable ;
    :environment "production" .

:ClickstreamETLJob rdf:type :GlueJob ;
    rdfs:label "Clickstream ETL Job" ;
    :arn "arn:aws:glue:us-east-1:123456789012:job/clickstream-etl" ;
    :readsFromTable :ClickstreamTable ;
    :environment "production" .

:AdHocQueriesWorkGroup rdf:type :AthenaWorkGroup ;
    rdfs:label "Ad Hoc Queries WorkGroup" ;
    :arn "arn:aws:athena:us-east-1:123456789012:workgroup/ad-hoc-queries" ;
    :environment "production" .

:GlueDataCatalog rdf:type :AthenaDataCatalog ;
    rdfs:label "Glue Data Catalog" ;
    :arn "arn:aws:athena:us-east-1:123456789012:datacatalog/AwsDataCatalog" ;
    :environment "production" .

:ClickstreamQueryExecution rdf:type :AthenaQueryExecution ;
    rdfs:label "Clickstream Daily Count Query" ;
    :runsInWorkGroup :AdHocQueriesWorkGroup ;
    :queriesTable :ClickstreamTable ;
    :sqlQuery "SELECT COUNT(*) FROM clickstream_events WHERE event_date = current_date"^^xsd:string ;
    :environment "production" .

:AnalyticsEMRCluster rdf:type :EMRCluster ;
    rdfs:label "Analytics EMR Cluster" ;
    :arn "arn:aws:elasticmapreduce:us-east-1:123456789012:cluster/j-2AXXXXXXGAPLF" ;
    :instanceCount "6"^^xsd:integer ;
    :hasStep :ClickstreamAggregationStep ;
    :environment "production" .

:ClickstreamAggregationStep rdf:type :EMRStep ;
    rdfs:label "Clickstream Aggregation Step" ;
    :processesTable :ClickstreamTable ;
    :environment "production" .

:AnalyticsNotebook rdf:type :EMRNotebook ;
    rdfs:label "Analytics Notebook" ;
    :arn "arn:aws:elasticmapreduce:us-east-1:123456789012:editor/e-ABCDEFGHIJKLMNOPQRSTUVWXY" ;
    :environment "production" .

:ClickstreamSearchDomain rdf:type :OpenSearchDomain ;
    rdfs:label "Clickstream Search Domain" ;
    :arn "arn:aws:es:us-east-1:123456789012:domain/clickstream-search" ;
    :searchEngineVersion "OpenSearch_2.11"^^xsd:string ;
    :hasIndex :ClickstreamIndex ;
    :environment "production" .

:ClickstreamIndex rdf:type :OpenSearchIndex ;
    rdfs:label "Clickstream Index" ;
    :environment "production" .

# Examples for AWS WAF (protects the existing CDNDistribution)
:PublicWebACL rdf:type :WAFWebACL ;
    rdfs:label "Public Web ACL" ;
    :arn "arn:aws:wafv2:us-east-1:123456789012:regional/webacl/public-web-acl/a1b2c3d4-5678-90ab-cdef-example11111" ;
    :scope "REGIONAL"^^xsd:string ;
    :defaultAction "ALLOW"^^xsd:string ;
    :hasRuleGroup :CommonThreatsRuleGroup ;
    :appliesTo :CDNDistribution ;
    :environment "production" .

:CommonThreatsRuleGroup rdf:type :WAFRuleGroup ;
    rdfs:label "Common Threats Rule Group" ;
    :arn "arn:aws:wafv2:us-east-1:123456789012:regional/rulegroup/common-threats/b2c3d4e5-6789-01bc-def0-example22222" ;
    :referencesIPSet :BlockedIPSet ;
    :environment "production" .

:BlockedIPSet rdf:type :WAFIPSet ;
    rdfs:label "Blocked IP Set" ;
    :arn "arn:aws:wafv2:us-east-1:123456789012:regional/ipset/blocked-ips/c3d4e5f6-7890-12cd-ef01-example33333" ;
    :environment "production" .

# Examples for AWS Config (evaluates compliance of the existing ProductionVPC)
:ProdConfigRecorder rdf:type :ConfigurationRecorder ;
    rdfs:label "Production Configuration Recorder" ;
    :environment "production" .

:VPCFlowLogsEnabledRule rdf:type :ConfigRule ;
    rdfs:label "VPC Flow Logs Enabled Rule" ;
    :arn "arn:aws:config:us-east-1:123456789012:config-rule/config-rule-vpcflow01" ;
    :evaluatesComplianceOf :ProductionVPC ;
    :complianceStatus "compliant"^^xsd:string ;
    :environment "production" .

:SecurityBaselineConformancePack rdf:type :ConfigConformancePack ;
    rdfs:label "Security Baseline Conformance Pack" ;
    :arn "arn:aws:config:us-east-1:123456789012:conformance-pack/security-baseline/conformance-pack-abc123" ;
    :hasConfigRule :VPCFlowLogsEnabledRule ;
    :environment "production" .

# Examples for AWS CloudFormation and AWS CodePipeline (provisions the existing WebServerInstance)
:WebTierStack rdf:type :CloudFormationStack ;
    rdfs:label "Web Tier Stack" ;
    :arn "arn:aws:cloudformation:us-east-1:123456789012:stack/web-tier-stack/d4e5f6a7-8901-23de-f012-example44444" ;
    :stackStatus "UPDATE_COMPLETE"^^xsd:string ;
    :provisionsResource :WebServerInstance ;
    :hasChangeSet :WebTierScaleUpChangeSet ;
    :environment "production" .

:WebTierScaleUpChangeSet rdf:type :CloudFormationChangeSet ;
    rdfs:label "Web Tier Scale-Up Change Set" ;
    :arn "arn:aws:cloudformation:us-east-1:123456789012:changeSet/web-tier-scale-up/e5f6a7b8-9012-34ef-0123-example55555" ;
    :environment "production" .

:MultiRegionWebTierStackSet rdf:type :CloudFormationStackSet ;
    rdfs:label "Multi-Region Web Tier StackSet" ;
    :arn "arn:aws:cloudformation:us-east-1:123456789012:stackset/multi-region-web-tier:f6a7b8c9-0123-45f0-1234-example66666" ;
    :hasStackInstance :WebTierStack ;
    :environment "production" .

:ReleasePipeline rdf:type :CodePipelinePipeline ;
    rdfs:label "Web Tier Release Pipeline" ;
    :arn "arn:aws:codepipeline:us-east-1:123456789012:web-tier-release" ;
    :hasPipelineStage :DeployStage ;
    :environment "production" .

:DeployStage rdf:type :CodePipelineStage ;
    rdfs:label "Deploy Stage" ;
    :stageOrder "3"^^xsd:integer ;
    :deploysStack :WebTierStack ;
    :environment "production" .

# Examples for AWS Direct Connect (attaches into the existing MainTransitGateway)
:CorpDXConnection rdf:type :DirectConnectConnection ;
    rdfs:label "Corporate Direct Connect Connection" ;
    :arn "arn:aws:directconnect:us-east-1:123456789012:dxcon/dxcon-fgabc123" ;
    :connectionBandwidth "10Gbps"^^xsd:string ;
    :hasVirtualInterface :CorpTransitVIF ;
    :environment "production" .

:CorpTransitVIF rdf:type :DirectConnectVirtualInterface ;
    rdfs:label "Corporate Transit Virtual Interface" ;
    :arn "arn:aws:directconnect:us-east-1:123456789012:dxvif/dxvif-fgxyz789" ;
    :virtualInterfaceType "transit"^^xsd:string ;
    :associatedWithGateway :CorpDXGateway ;
    :environment "production" .

:CorpDXGateway rdf:type :DirectConnectGateway ;
    rdfs:label "Corporate Direct Connect Gateway" ;
    :arn "arn:aws:directconnect::123456789012:dx-gateway/dxgw-abc123de" ;
    :environment "production" .

:CorpDXGatewayAttachment rdf:type :TransitGatewayAttachment ;
    rdfs:label "Corporate Direct Connect Gateway Attachment" ;
    :arn "arn:aws:ec2:us-east-1:123456789012:transit-gateway-attachment/tgw-attach-0abcdef1234567890" ;
    :attachesDirectConnectGateway :CorpDXGateway ;
    :environment "production" .
