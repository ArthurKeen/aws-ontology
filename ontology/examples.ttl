# Structured policy statements for previously free-text-only policies
# (mirrors each policy's existing :policyDocument, closes drift alert
# aws-ontology_REQ-018-policy-statement-coverage). AWSManagedPolicy individuals
# with no policyDocument at all (AmazonEKSClusterPolicy, AmazonEKSWorkerNodePolicy,
# AmazonEKS_CNI_Policy, AmazonEC2ContainerRegistryReadOnly, S3ReadOnlyAccess,
# LambdaBasicExecution) are deliberately left without a structured statement: their
# content is defined and owned by AWS, referenced here only by ARN.

:AllowSecurityAuditActions rdf:type :PolicyStatement ;
    rdfs:label "Allow Security Audit Actions" ;
    :hasEffect :Allow ;
    :hasAction :SecurityHubGetAction, :SecurityHubListAction, :CloudTrailLookupEventsAction ;
    :hasStatementResource :AllResourcesWildcard .

:AllowECSTaskExecutionActions rdf:type :PolicyStatement ;
    rdfs:label "Allow ECS Task Execution Actions" ;
    :hasEffect :Allow ;
    :hasAction :ECRGetAuthorizationTokenAction, :ECRBatchCheckLayerAvailabilityAction,
        :ECRGetDownloadUrlForLayerAction, :ECRBatchGetImageAction ;
    :hasStatementResource :AllResourcesWildcard .

:AllowEC2BasicAccessActions rdf:type :PolicyStatement ;
    rdfs:label "Allow EC2 Basic Access Actions" ;
    :hasEffect :Allow ;
    :hasAction :EC2DescribeInstancesAction, :EC2DescribeImagesAction, :EC2DescribeKeyPairsAction ;
    :hasStatementResource :AllResourcesWildcard .

:AllowIAMAuditActions rdf:type :PolicyStatement ;
    rdfs:label "Allow IAM Audit Actions" ;
    :hasEffect :Allow ;
    :hasAction :IAMListAction, :IAMGetAction, :IAMGenerateAction ;
    :hasStatementResource :AllResourcesWildcard .

:AllowAPIGatewayExecutionActions rdf:type :PolicyStatement ;
    rdfs:label "Allow API Gateway Execution Actions" ;
    :hasEffect :Allow ;
    :hasAction :LambdaInvokeFunctionAction, :StatesStartExecutionAction ;
    :hasStatementResource :AllResourcesWildcard .

:AllowStepFunctionExecutionActions rdf:type :PolicyStatement ;
    rdfs:label "Allow Step Function Execution Actions" ;
    :hasEffect :Allow ;
    :hasAction :LambdaInvokeFunctionAction, :SNSPublishAction, :SQSSendMessageAction ;
    :hasStatementResource :AllResourcesWildcard .

:AllowEventBridgeExecutionActions rdf:type :PolicyStatement ;
    rdfs:label "Allow EventBridge Execution Actions" ;
    :hasEffect :Allow ;
    :hasAction :SNSPublishAction, :SQSSendMessageAction, :LambdaInvokeFunctionAction ;
    :hasStatementResource :AllResourcesWildcard .

:SecurityHubGetAction rdf:type :Action ;
    rdfs:label "security-hub:Get*" .

:SecurityHubListAction rdf:type :Action ;
    rdfs:label "securityhub:List*" .

:CloudTrailLookupEventsAction rdf:type :Action ;
    rdfs:label "cloudtrail:LookupEvents" .

:ECRGetAuthorizationTokenAction rdf:type :Action ;
    rdfs:label "ecr:GetAuthorizationToken" .

:ECRBatchCheckLayerAvailabilityAction rdf:type :Action ;
    rdfs:label "ecr:BatchCheckLayerAvailability" .

:ECRGetDownloadUrlForLayerAction rdf:type :Action ;
    rdfs:label "ecr:GetDownloadUrlForLayer" .

:ECRBatchGetImageAction rdf:type :Action ;
    rdfs:label "ecr:BatchGetImage" .

:EC2DescribeInstancesAction rdf:type :Action ;
    rdfs:label "ec2:DescribeInstances" .

:EC2DescribeImagesAction rdf:type :Action ;
    rdfs:label "ec2:DescribeImages" .

:EC2DescribeKeyPairsAction rdf:type :Action ;
    rdfs:label "ec2:DescribeKeyPairs" .

:IAMListAction rdf:type :Action ;
    rdfs:label "iam:List*" .

:IAMGetAction rdf:type :Action ;
    rdfs:label "iam:Get*" .

:IAMGenerateAction rdf:type :Action ;
    rdfs:label "iam:Generate*" .

:LambdaInvokeFunctionAction rdf:type :Action ;
    rdfs:label "lambda:InvokeFunction" .

:StatesStartExecutionAction rdf:type :Action ;
    rdfs:label "states:StartExecution" .

:SNSPublishAction rdf:type :Action ;
    rdfs:label "sns:Publish" .

:SQSSendMessageAction rdf:type :Action ;
    rdfs:label "sqs:SendMessage" .

