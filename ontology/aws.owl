    <rdfs:comment>Relates resources to their VPC</rdfs:comment>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#VPC"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#environment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
