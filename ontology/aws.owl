<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#AnalyticsResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Analytics Resource</rdfs:label>
    <rdfs:comment>Base class for data analytics, ETL, streaming, and search-analytics resources</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#AIResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#ComputeResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#IntegrationResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#StorageResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#Route53HostedZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Route 53 Hosted Zone</rdfs:label>
    <rdfs:comment>A DNS hosted zone managed by Amazon Route 53</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#stateMachineType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
    <rdfs:label>state machine type</rdfs:label>
    <rdfs:comment>Type of Step Function (STANDARD or EXPRESS)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#StepFunction"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#runsOnCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>runs on cluster</rdfs:label>
    <rdfs:comment>Relates container services/tasks to their cluster</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#dependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#taskDefinitionRevision">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>task definition revision</rdfs:label>
    <rdfs:comment>Revision number of the task definition</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ECSTaskDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#receivesCostFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>receives cost from</rdfs:label>
    <rdfs:comment>Inverse of allocates cost to</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#allocatesCostTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#maxNodes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>maximum nodes</rdfs:label>
    <rdfs:comment>Maximum number of nodes in the node group</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#EKSNodeGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#findingType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>finding type</rdfs:label>
    <rdfs:comment>GuardDuty finding type identifier (e.g. UnauthorizedAccess:EC2/SSHBruteForce)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#GuardDutyFinding"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#scope">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>scope</rdfs:label>
    <rdfs:comment>The WAF scope a web ACL is associated with (REGIONAL or CLOUDFRONT)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#WAFWebACL"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasChangeSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has change set</rdfs:label>
    <rdfs:comment>Relates a CloudFormation stack to a pending change set proposing updates to it</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#contains"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#CloudFormationStack"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#CloudFormationChangeSet"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has stage</rdfs:label>
    <rdfs:comment>Relates an API Gateway to its deployment stages</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#APIGateway"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#APIGatewayStage"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#NetworkingResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label>Networking Resource</rdfs:label>
    <rdfs:comment>Base class for networking resources</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#IntegrationResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
    <skos:prefLabel>Networking Resource</skos:prefLabel>
    <skos:inScheme rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResourceCategoryScheme"/>
    <skos:topConceptOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResourceCategoryScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#dependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>depends on</rdfs:label>
    <rdfs:comment>General dependency relationship between resources</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#CodePipelinePipeline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CodePipeline Pipeline</rdfs:label>
    <rdfs:comment>An AWS CodePipeline continuous-delivery pipeline that orchestrates build, test, and deploy stages</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DeploymentResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#AWSResourceCategoryScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label>AWS Resource Category Scheme</rdfs:label>
    <skos:prefLabel>AWS Resource Category Scheme</skos:prefLabel>
    <skos:hasTopConcept rdf:resource="http://www.semanticweb.org/aws-ontology#ComputeResource"/>
    <skos:hasTopConcept rdf:resource="http://www.semanticweb.org/aws-ontology#StorageResource"/>
    <skos:hasTopConcept rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
    <skos:hasTopConcept rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
    <skos:hasTopConcept rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
    <skos:hasTopConcept rdf:resource="http://www.semanticweb.org/aws-ontology#IntegrationResource"/>
    <skos:hasTopConcept rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
    <skos:hasTopConcept rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
    <skos:hasTopConcept rdf:resource="http://www.semanticweb.org/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#topicReceivesFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>topic receives from</rdfs:label>
    <rdfs:comment>Inverse of publishes to topic</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#publishesToTopic"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#logsActivityOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>logs activity of</rdfs:label>
    <rdfs:comment>Relates logging resources to their subjects</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#CloudTrailLog"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSAccount"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#CloudFormationStack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CloudFormation Stack</rdfs:label>
    <rdfs:comment>A CloudFormation stack representing a collection of AWS resources managed as a single provisioning unit</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DeploymentResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#kubernetesVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>Kubernetes version</rdfs:label>
    <rdfs:comment>Version of Kubernetes running on EKS cluster</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#EKSCluster"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#DirectConnectConnection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Direct Connect Connection</rdfs:label>
    <rdfs:comment>A dedicated physical network connection between an AWS Direct Connect location and an on-premises network</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#AWSManagedPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>AWS Managed Policy</rdfs:label>
    <rdfs:comment>An AWS-provided managed policy</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#ManagedPolicy"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#CustomerManagedPolicy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#controls">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>controls</rdfs:label>
    <rdfs:comment>Inverse of controlled by</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#controlledBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#GlueJob">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Glue Job</rdfs:label>
    <rdfs:comment>A Glue ETL job that transforms data between sources</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#enforces">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>enforces</rdfs:label>
    <rdfs:comment>Indicates that a resource enforces compliance rules</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#KMSAlias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>KMS Alias</rdfs:label>
    <rdfs:comment>An alias for a KMS key</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has region</rdfs:label>
    <rdfs:comment>Relates an AWS account to its regions</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSAccount"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#CloudFrontDistribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CloudFront Distribution</rdfs:label>
    <rdfs:comment>An Amazon CloudFront content delivery network distribution</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#DeploymentResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Deployment Resource</rdfs:label>
    <rdfs:comment>Base class for infrastructure-as-code provisioning and continuous-delivery pipeline resources</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#AIResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#AnalyticsResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#ComputeResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#IntegrationResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#StorageResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#attachesDirectConnectGateway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>attaches Direct Connect gateway</rdfs:label>
    <rdfs:comment>Relates a Transit Gateway attachment to the Direct Connect gateway it connects</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#TransitGatewayAttachment"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#DirectConnectGateway"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#searchEngineVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>search engine version</rdfs:label>
    <rdfs:comment>The OpenSearch or Elasticsearch engine version running on a domain</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#OpenSearchDomain"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#RDSSnapshot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RDS Snapshot</rdfs:label>
    <rdfs:comment>A snapshot of an RDS database instance or cluster</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#StorageResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#DynamoDBTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DynamoDB Table</rdfs:label>
    <rdfs:comment>An Amazon DynamoDB table</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#scheduledDeletion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>scheduled deletion</rdfs:label>
    <rdfs:comment>Scheduled deletion date for the resource</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#TransitGateway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Transit Gateway</rdfs:label>
    <rdfs:comment>A network transit hub connecting VPCs and on-premises networks</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#dataClassification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>data classification</rdfs:label>
    <rdfs:comment>Data classification level (public, internal, confidential, restricted)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ECSTaskDefinition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ECS Task Definition</rdfs:label>
    <rdfs:comment>A blueprint for ECS tasks specifying containers and resources</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#ComputeResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#IdentityResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label>Identity Resource</rdfs:label>
    <rdfs:comment>Base class for identity and access management resources</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#IntegrationResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
    <skos:prefLabel>Identity Resource</skos:prefLabel>
    <skos:inScheme rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResourceCategoryScheme"/>
    <skos:topConceptOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResourceCategoryScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#sharesResourcesWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:label>shares resources with</rdfs:label>
    <rdfs:comment>Indicates resource sharing for cost efficiency</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#Resource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Resource</rdfs:label>
    <rdfs:comment>An AWS resource ARN</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#CustomerManagedPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Customer Managed Policy</rdfs:label>
    <rdfs:comment>A customer-created managed policy</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#ManagedPolicy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasUserPoolClient">
