    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has account</rdfs:label>
    <rdfs:comment>Relates an Organization to a member account</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#contains"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#Organization"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSAccount"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#imageDigest">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>image digest</rdfs:label>
    <rdfs:comment>SHA256 digest of the container image</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ContainerImage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#TransitGatewayRouteTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Transit Gateway Route Table</rdfs:label>
    <rdfs:comment>A route table controlling traffic between Transit Gateway attachments</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#Subnet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Subnet</rdfs:label>
    <rdfs:comment>A subnet within a VPC</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ruleType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>rule type</rdfs:label>
    <rdfs:comment>Security group rule type (ingress/egress)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityGroupRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has activity</rdfs:label>
    <rdfs:comment>Relates a Step Function to its activities</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#StepFunction"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#StepFunctionActivity"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/aws-ontology#belongsToRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#RDSInstance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RDS Instance</rdfs:label>
    <rdfs:comment>An Amazon RDS database instance</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ConfigurationRecorder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Configuration Recorder</rdfs:label>
    <rdfs:comment>The AWS Config configuration recorder that tracks resource configuration changes for an account and region</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#CodePipelineStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CodePipeline Stage</rdfs:label>
    <rdfs:comment>A named stage within a CodePipeline pipeline (e.g. Source, Build, Deploy) executing one or more actions in sequence</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DeploymentResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#APIGatewayResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>API Gateway Resource</rdfs:label>
    <rdfs:comment>A logical entity that an app developer accesses via API Gateway</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#IAMUser">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>IAM User</rdfs:label>
    <rdfs:comment>An IAM user entity</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb3"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb13">
    <rdf:first rdf:resource="http://www.semanticweb.org/aws-ontology#arn"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ElastiCacheCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ElastiCache Cluster</rdfs:label>
    <rdfs:comment>An Amazon ElastiCache cluster (a Redis or Memcached cache node group)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#encryptedWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>encrypted with</rdfs:label>
    <rdfs:comment>KMS key used for encryption</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#KMSKey"/>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#uses"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#AWSRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>AWS Region</rdfs:label>
    <rdfs:comment>A geographical region containing AWS resources</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasGuardrail">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has guardrail</rdfs:label>
    <rdfs:comment>Relates a Bedrock agent to a guardrail applied to its model invocations</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#BedrockAgent"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#BedrockGuardrail"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#optimizes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>optimizes</rdfs:label>
    <rdfs:comment>Inverse of optimized by</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#optimizedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#stageName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>stage name</rdfs:label>
    <rdfs:comment>Name of the API Gateway deployment stage</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#APIGatewayStage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ControlTowerLandingZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Control Tower Landing Zone</rdfs:label>
    <rdfs:comment>An AWS Control Tower landing zone governing an AWS Organization with pre-configured guardrails</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#SageMakerNotebookInstance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SageMaker Notebook Instance</rdfs:label>
    <rdfs:comment>A managed Jupyter notebook instance for SageMaker model development</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb7">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/aws-ontology#hasTarget"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#OpenSearchIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>OpenSearch Index</rdfs:label>
    <rdfs:comment>A logical index within an OpenSearch domain</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#engineVersion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>engine version</rdfs:label>
    <rdfs:comment>Database engine version</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#multiRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>multi region</rdfs:label>
    <rdfs:comment>Whether KMS key is multi-region</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#KMSKey"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#IdentityCenterInstance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Identity Center Instance</rdfs:label>
    <rdfs:comment>An AWS IAM Identity Center instance providing centralized workforce access management across an AWS Organization</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#NetworkACL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Network ACL</rdfs:label>
    <rdfs:comment>A network access control list</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#IAMInstanceProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>IAM Instance Profile</rdfs:label>
    <rdfs:comment>An instance profile that provides temporary credentials to EC2 instances</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#enforcedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>enforced by</rdfs:label>
    <rdfs:comment>Inverse of enforces</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#enforces"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#EC2SecurityGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>EC2 Security Group</rdfs:label>
    <rdfs:comment>A security group controlling EC2 instance access</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
  </rdf:Description>
</rdf:RDF>
