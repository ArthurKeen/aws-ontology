  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasAttachment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has attachment</rdfs:label>
