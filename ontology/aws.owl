  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#associatedWithGateway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a transit virtual interface to the Direct Connect gateway it is associated with</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DirectConnectVirtualInterface"/>
    <rdfs:label>associated with gateway</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DirectConnectGateway"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#dependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#attachedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates resources that are attached to other resources</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>attached to</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#dependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#attachedToSubnet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
