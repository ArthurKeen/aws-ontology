    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#TransitGatewayAttachment"/>
    <rdfs:label>attaches VPC</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#VPC"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#attachmentOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Inverse of attached to</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>attachment of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <owl:inverseOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#attachedTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#auditedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Indicates audit relationships for compliance tracking</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>audited by</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#audits">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Inverse of audited by</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>audits</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <owl:inverseOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#auditedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#availabilityZoneOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Inverse of has availability zone</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AvailabilityZone"/>
    <rdfs:label>availability zone of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSRegion"/>
    <owl:inverseOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#hasAvailabilityZone"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#belongsToOrganizationalUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an AWS account to the organizational unit that contains it</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSAccount"/>
    <rdfs:label>belongs to organizational unit</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#OrganizationalUnit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#belongsToRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates resources to the AWS region they reside in</rdfs:comment>
    <rdfs:label>belongs to region</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#belongsToVPC">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates resources to their VPC</rdfs:comment>
    <rdfs:label>belongs to VPC</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#VPC"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#billingMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Billing mode (on-demand, reserved, spot, etc.)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>billing mode</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#bucketVersioning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>S3 bucket versioning status</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#S3Bucket"/>
    <rdfs:label>bucket versioning</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#budgetAllocated">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Budget allocated for this resource in USD</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>budget allocated</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#cacheNodeType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The compute and memory capacity class of a cache node (e.g. cache.r6g.large)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ElastiCacheCluster"/>
    <rdfs:label>cache node type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#canAssumeRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an IAM principal (user or role) to an IAM role it is permitted to assume via sts:AssumeRole</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMEntity"/>
    <rdfs:label>can assume role</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#canList">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Derived: the principal is effectively allowed at least one List access-level action on the resource (e.g. s3:ListBucket, ec2:DescribeInstances)</rdfs:comment>
    <rdfs:label>can list</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#hasEffectiveAccess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#canManagePermissions">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Derived: the principal is effectively allowed at least one Permissions management access-level action on the resource (e.g. s3:PutBucketPolicy, iam:AttachRolePolicy), so it can change who else has access</rdfs:comment>
    <rdfs:label>can manage permissions</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#hasEffectiveAccess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#canRead">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Derived: the principal is effectively allowed at least one Read access-level action on the resource (e.g. s3:GetObject)</rdfs:comment>
    <rdfs:label>can read</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#hasEffectiveAccess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#canTag">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Derived: the principal is effectively allowed at least one Tagging access-level action on the resource (e.g. s3:PutBucketTagging, ec2:CreateTags). Tags can drive attribute-based access control, so tagging can change access</rdfs:comment>
    <rdfs:label>can tag</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#hasEffectiveAccess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#canWrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Derived: the principal is effectively allowed at least one Write access-level action on the resource (e.g. s3:PutObject, s3:DeleteObject)</rdfs:comment>
    <rdfs:label>can write</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#hasEffectiveAccess"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#chargedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Inverse of incurs charge for</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>charged by</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <owl:inverseOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#incursChargeFor"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#cidrBlock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>An IPv4 CIDR block: the address range of a network (VPC, subnet) or the range a security group rule or network ACL entry matches</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>CIDR block</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#clusterHosts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Inverse of runs on cluster</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>cluster hosts</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <owl:inverseOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#runsOnCluster"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#complianceStandard">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Compliance standard or regulation (SOC2, HIPAA, PCI-DSS, etc.)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>compliance standard</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#complianceStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Current compliance status (compliant, non-compliant, pending, exempt)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>compliance status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#compliesWith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Indicates compliance with standards, regulations, or policies</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>complies with</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#connectionBandwidth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The provisioned bandwidth of a Direct Connect connection (e.g. 1Gbps, 10Gbps)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DirectConnectConnection"/>
    <rdfs:label>connection bandwidth</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#containedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Inverse of contains</rdfs:comment>
    <rdfs:label>contained by</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#containerImageUsedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Inverse of uses container image</rdfs:comment>
    <rdfs:label>container image used by</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#usesContainerImage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#containerPort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Port exposed by container</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ECSTaskDefinition"/>
    <rdfs:label>container port</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#contains">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>General containment relationship</rdfs:comment>
    <rdfs:label>contains</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#controlledBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
