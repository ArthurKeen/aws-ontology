    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#EventBridgeRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#SecretsManagerSecret">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Secrets Manager Secret</rdfs:label>
    <rdfs:comment>A secret stored in AWS Secrets Manager</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ECSTask">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ECS Task</rdfs:label>
    <rdfs:comment>An ECS task running one or more containers</rdfs:comment>
