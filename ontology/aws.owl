    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>GuardDuty finding type identifier (e.g. UnauthorizedAccess:EC2/SSHBruteForce)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#GuardDutyFinding"/>
    <rdfs:label>finding type</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#fromPort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>Starting port number for security group rule</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#SecurityGroupRule"/>
    <rdfs:label>from port</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#governsOrganization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a Control Tower landing zone to the Organization it governs</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ControlTowerLandingZone"/>
    <rdfs:label>governs organization</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#Organization"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#manages"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#governsPatchingFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an SSM patch baseline to a resource whose patching it governs</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#SSMPatchBaseline"/>
    <rdfs:label>governs patching for</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#manages"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#guardrailAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment>The action a guardrail takes on a policy violation (e.g. BLOCK, ANONYMIZE)</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#BedrockGuardrail"/>
    <rdfs:label>guardrail action</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasAccount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an Organization to a member account</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#Organization"/>
    <rdfs:label>has account</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSAccount"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates policy statements to their actions</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#PolicyStatement"/>
    <rdfs:label>has action</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#Action"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a Step Function to its activities</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#StepFunction"/>
    <rdfs:label>has activity</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#StepFunctionActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasAttachment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a Transit Gateway to an attachment it manages</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#TransitGateway"/>
    <rdfs:label>has attachment</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#TransitGatewayAttachment"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasAvailabilityZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a region to its availability zones</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSRegion"/>
    <rdfs:label>has availability zone</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AvailabilityZone"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasCacheCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an ElastiCache replication group to a cluster (shard) it comprises</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ElastiCacheReplicationGroup"/>
    <rdfs:label>has cache cluster</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ElastiCacheCluster"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasChangeSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a CloudFormation stack to a pending change set proposing updates to it</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#CloudFormationStack"/>
    <rdfs:label>has change set</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#CloudFormationChangeSet"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates policy statements to their conditions</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#PolicyStatement"/>
    <rdfs:label>has condition</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#Condition"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasConfigRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a Config conformance pack to a rule it bundles</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ConfigConformancePack"/>
    <rdfs:label>has config rule</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ConfigRule"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasEffect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates policy statements to their effects</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#PolicyStatement"/>
    <rdfs:label>has effect</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#Effect"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasEffectiveAccess">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Derived: after policy evaluation, the principal is allowed at least one action on the resource. For an IAM group, this is the access its members inherit through it. Not an AWS attribute; computed from policies, boundaries, SCPs and role assumption.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>has effective access</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasExecutionRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The IAM role the resource itself uses to call AWS services (e.g. a Lambda function's execution role, which Lambda assumes when the function is invoked). Not a role an AWS service uses only to operate the resource on its behalf: for ECS, record the task role on the task definition (taskRoleArn), not the task execution role the ECS agent uses to pull images and write logs. See https://docs.aws.amazon.com/lambda/latest/dg/lambda-intro-execution-role.html</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>has execution role</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMRole"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#uses"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasFinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a GuardDuty detector to a finding it generated</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#GuardDutyDetector"/>
    <rdfs:label>has finding</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#GuardDutyFinding"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasGuardrail">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a Bedrock agent to a guardrail applied to its model invocations</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#BedrockAgent"/>
    <rdfs:label>has guardrail</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#BedrockGuardrail"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasHealthCheck">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a Route 53 record set to the health check governing its failover routing</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#Route53RecordSet"/>
    <rdfs:label>has health check</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#Route53HealthCheck"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasIdentityProvider">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a Cognito user pool to a federation identity provider configured within it</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#CognitoUserPool"/>
    <rdfs:label>has identity provider</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#CognitoIdentityProvider"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasIndex">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an OpenSearch domain to an index it hosts</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#OpenSearchDomain"/>
    <rdfs:label>has index</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#OpenSearchIndex"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasInstanceProfile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>The IAM instance profile attached to an EC2 instance; applications on the instance receive temporary credentials for the profile's role. An instance can have only one IAM role attached, through one instance profile. See https://docs.aws.amazon.com/AWSEC2/latest/UserGuide/iam-roles-for-amazon-ec2.html</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#EC2Instance"/>
    <rdfs:label>has instance profile</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMInstanceProfile"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#attachedTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Inverse of member of</rdfs:comment>
    <rdfs:label>has member</rdfs:label>
    <owl:inverseOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#memberOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an API Gateway resource to its HTTP methods</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#APIGatewayResource"/>
    <rdfs:label>has method</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#APIGatewayMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasNodeGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates EKS clusters to their node groups</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#EKSCluster"/>
    <rdfs:label>has node group</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#EKSNodeGroup"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasOrganizationalUnit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an Organization to an organizational unit it contains</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#Organization"/>
    <rdfs:label>has organizational unit</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#OrganizationalUnit"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasPermissionBoundary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates IAM entities (users and roles) to their permission boundary policies</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMEntity"/>
    <rdfs:label>has permission boundary</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMPermissionBoundary"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasPermissionSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an Identity Center instance to a permission set it defines</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityCenterInstance"/>
    <rdfs:label>has permission set</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#PermissionSet"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasPipelineStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a CodePipeline pipeline to a stage it executes in sequence</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#CodePipelinePipeline"/>
    <rdfs:label>has pipeline stage</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#CodePipelineStage"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates IAM entities (users, roles, groups) to their attached policies</rdfs:comment>
    <rdfs:label>has policy</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMPolicy"/>
    <owl:equivalentProperty rdf:resource="https://w3id.org/arango-solutions/aws-ontology#hasPolicyAttachment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasPolicyAttachment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates IAM identities (users, groups, roles) to their attached policies</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMIdentity"/>
    <rdfs:label>has policy attachment</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMPolicy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasRecordSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a Route 53 hosted zone to a DNS record set it contains</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#Route53HostedZone"/>
    <rdfs:label>has record set</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#Route53RecordSet"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an AWS account to its regions</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSAccount"/>
    <rdfs:label>has region</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an API Gateway to its resources</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#APIGateway"/>
    <rdfs:label>has resource</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#APIGatewayResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>IAM role associated with instance profile</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMInstanceProfile"/>
    <rdfs:label>has role</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IAMRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasRouteTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates a Transit Gateway to a route table it manages</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#TransitGateway"/>
    <rdfs:label>has route table</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#TransitGatewayRouteTable"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an EventBridge to its rules</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#EventBridge"/>
    <rdfs:label>has rule</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#EventBridgeRule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#hasRuleGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
