  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#EMRCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>EMR Cluster</rdfs:label>
    <rdfs:comment>A managed Hadoop/Spark cluster running on Amazon EMR</rdfs:comment>
