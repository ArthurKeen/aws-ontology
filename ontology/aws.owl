    <rdfs:comment>Environment classification (dev, test, staging, production)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasConfigRule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has config rule</rdfs:label>
    <rdfs:comment>Relates a Config conformance pack to a rule it bundles</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#contains"/>
