    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Athena Data Catalog</rdfs:label>
    <rdfs:comment>A data source catalog registered with Athena (e.g. the AWS Glue Data Catalog)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#desiredCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>desired count</rdfs:label>
    <rdfs:comment>Desired number of running tasks in an ECS service</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ECSService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#governsOrganization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>governs organization</rdfs:label>
    <rdfs:comment>Relates a Control Tower landing zone to the Organization it governs</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#manages"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ControlTowerLandingZone"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#Organization"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#nodeGroupOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>node group of</rdfs:label>
    <rdfs:comment>Inverse of has node group</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#hasNodeGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#federatesUserPool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>federates user pool</rdfs:label>
    <rdfs:comment>Relates a Cognito identity pool to a user pool it federates as an identity provider</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#uses"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#CognitoIdentityPool"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#CognitoUserPool"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#TransitGatewayAttachment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Transit Gateway Attachment</rdfs:label>
    <rdfs:comment>Attaches a VPC, VPN, Direct Connect gateway, or peering connection to a Transit Gateway</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#CognitoIdentityPool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Cognito Identity Pool</rdfs:label>
    <rdfs:comment>An Amazon Cognito identity pool that federates identity providers to grant temporary AWS credentials</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#Condition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Condition</rdfs:label>
    <rdfs:comment>A condition for policy evaluation</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#migratedFrom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>migrated from</rdfs:label>
    <rdfs:comment>Indicates migration source for a resource</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has action</rdfs:label>
    <rdfs:comment>Relates policy statements to their actions</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#PolicyStatement"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#Action"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#RouteTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Route Table</rdfs:label>
    <rdfs:comment>A VPC route table</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#instanceType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>instance type</rdfs:label>
    <rdfs:comment>EC2 instance type</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#EC2Instance"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#multiAZ">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>multi AZ</rdfs:label>
    <rdfs:comment>Whether resource spans multiple availability zones</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#activityOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>activity of</rdfs:label>
    <rdfs:comment>Inverse of has activity</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#StepFunctionActivity"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#StepFunction"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#hasActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#AvailabilityZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Availability Zone</rdfs:label>
    <rdfs:comment>An isolated location within a region</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#memory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>memory</rdfs:label>
    <rdfs:comment>Memory allocated to container or task in MB</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ECSTaskDefinition"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasTarget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has target</rdfs:label>
    <rdfs:comment>Relates an EventBridge rule to its targets</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#EventBridgeRule"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#EventBridgeTarget"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#targetType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>target type</rdfs:label>
    <rdfs:comment>Type of load balancer target</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ELBv2TargetGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasCacheCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has cache cluster</rdfs:label>
    <rdfs:comment>Relates an ElastiCache replication group to a cluster (shard) it comprises</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#contains"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ElastiCacheReplicationGroup"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#ElastiCacheCluster"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasStep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has step</rdfs:label>
    <rdfs:comment>Relates an EMR cluster to a step submitted to it</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#contains"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#EMRCluster"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#EMRStep"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#AthenaWorkGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Athena WorkGroup</rdfs:label>
    <rdfs:comment>An Athena workgroup grouping queries under shared settings and cost controls</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#discoversTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>discovers table</rdfs:label>
    <rdfs:comment>Relates a Glue crawler to a table it discovered and catalogued</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#manages"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#GlueCrawler"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#GlueTable"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#findingSeverity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>finding severity</rdfs:label>
    <rdfs:comment>GuardDuty finding severity score (0.1-8.9)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#GuardDutyFinding"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#numberOfNodes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>number of nodes</rdfs:label>
    <rdfs:comment>Number of nodes in cluster</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasMember">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has member</rdfs:label>
    <rdfs:comment>Inverse of member of</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#memberOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ECSContainerInstance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ECS Container Instance</rdfs:label>
    <rdfs:comment>An EC2 instance registered to an ECS cluster</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#ComputeResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#engineType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>engine type</rdfs:label>
    <rdfs:comment>The cache engine (redis or memcached)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ElastiCacheCluster"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#distributionId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>distribution ID</rdfs:label>
    <rdfs:comment>CloudFront distribution identifier</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#CloudFrontDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#EMRStep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>EMR Step</rdfs:label>
    <rdfs:comment>A processing step (job) submitted to an EMR cluster</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AnalyticsResource"/>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#lastModifiedDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>last modified date</rdfs:label>
    <rdfs:comment>Date when the resource was last modified</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#maxInstances">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>max instances</rdfs:label>
    <rdfs:comment>Maximum number of instances</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AutoScalingGroup"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#resourceOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>resource of</rdfs:label>
    <rdfs:comment>Inverse of has resource</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#hasResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ManagedPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Managed Policy</rdfs:label>
    <rdfs:comment>An IAM managed policy (AWS or Customer managed)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IAMPolicy"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#InlinePolicy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ConfigConformancePack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Config Conformance Pack</rdfs:label>
    <rdfs:comment>A Config conformance pack bundling a collection of Config rules and remediation actions for a common compliance framework</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#aggregatesFinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>aggregates finding</rdfs:label>
    <rdfs:comment>Relates Security Hub to a finding it aggregates from another detective service (e.g. GuardDuty)</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#contains"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityHubHub"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#GuardDutyFinding"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#maxSessionDuration">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>max session duration</rdfs:label>
    <rdfs:comment>Maximum session duration in seconds</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#IAMRole"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/aws-ontology#hasActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#EC2Instance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>EC2 Instance</rdfs:label>
    <rdfs:comment>An Amazon EC2 virtual machine instance</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#ComputeResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#belongsToRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>belongs to region</rdfs:label>
    <rdfs:comment>Relates resources to the AWS region they reside in</rdfs:comment>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#isDefault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>is default</rdfs:label>
    <rdfs:comment>Whether this is a default resource</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#InternetGateway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Internet Gateway</rdfs:label>
    <rdfs:comment>A VPC internet gateway</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#precedes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>precedes</rdfs:label>
    <rdfs:comment>Inverse of succeeds</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#succeeds"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#DocumentDBCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>DocumentDB Cluster</rdfs:label>
    <rdfs:comment>An Amazon DocumentDB cluster</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#SageMakerEndpoint">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SageMaker Endpoint</rdfs:label>
    <rdfs:comment>A hosted SageMaker endpoint serving real-time inference from a deployed model</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#RedshiftCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Redshift Cluster</rdfs:label>
    <rdfs:comment>An Amazon Redshift data warehouse cluster</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#SSMDocument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SSM Document</rdfs:label>
    <rdfs:comment>A Systems Manager automation or command document</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasStatement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has statement</rdfs:label>
    <rdfs:comment>Relates policies to their statements</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#IAMPolicy"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#PolicyStatement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#sendsToQueue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>sends to queue</rdfs:label>
    <rdfs:comment>Indicates that a service sends messages to an SQS queue</rdfs:comment>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#SQSQueue"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#sourceStream">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>source stream</rdfs:label>
    <rdfs:comment>Relates a Firehose delivery stream to the Kinesis stream it reads from</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#dependsOn"/>
