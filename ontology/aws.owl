  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#AIResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label>AI Resource</rdfs:label>
    <rdfs:comment>Base class for artificial intelligence and generative AI resources</rdfs:comment>
