    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>approves use of</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <owl:inverseOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#requiresApprovalFrom"/>
