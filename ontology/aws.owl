    <rdfs:comment>A CloudWatch alarm</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#AutoScalingGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Auto Scaling Group</rdfs:label>
    <rdfs:comment>An Amazon EC2 Auto Scaling group</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#ComputeResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ECSCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>ECS Cluster</rdfs:label>
    <rdfs:comment>An Amazon Elastic Container Service cluster</rdfs:comment>
