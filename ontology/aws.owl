    <rdfs:comment>Inverse of has region</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#hasRegion"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#guardrailAction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>guardrail action</rdfs:label>
    <rdfs:comment>The action a guardrail takes on a policy violation (e.g. BLOCK, ANONYMIZE)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#BedrockGuardrail"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#monitors">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>monitors</rdfs:label>
    <rdfs:comment>Relates monitoring resources to their targets</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#CloudWatchAlarm"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#CloudWatchMetric"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ELBv2TargetGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
