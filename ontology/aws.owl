    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#IAMUser"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#IAMPermissionBoundary"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#path">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>path</rdfs:label>
    <rdfs:comment>IAM entity path</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#resourcePath">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>resource path</rdfs:label>
