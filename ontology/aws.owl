  <rdf:Description rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb11">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/aws-ontology#hasStatement"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasPermissionBoundary">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has permission boundary</rdfs:label>
    <rdfs:comment>Relates IAM entities to their permission boundary policies</rdfs:comment>
