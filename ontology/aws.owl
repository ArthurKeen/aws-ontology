    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#EFSFileSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#methodOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>method of</rdfs:label>
    <rdfs:comment>Inverse of has method</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#hasMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#IdentityCenterPrincipal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Identity Center Principal</rdfs:label>
    <rdfs:comment>Abstract base class for Identity Center directory principals (users and groups)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#serviceName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>service name</rdfs:label>
    <rdfs:comment>Name of AWS service for VPC endpoint</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#VPCEndpoint"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#GlueTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Glue Table</rdfs:label>
    <rdfs:comment>A Glue Data Catalog table describing the schema and location of a dataset</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#clusterHosts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>cluster hosts</rdfs:label>
    <rdfs:comment>Inverse of runs on cluster</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#runsOnCluster"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#domainName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>domain name</rdfs:label>
    <rdfs:comment>Domain name for CloudFront distribution</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#CloudFrontDistribution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasStackInstance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has stack instance</rdfs:label>
    <rdfs:comment>Relates a CloudFormation StackSet to a stack instance it deploys into a target account and region</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#contains"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#CloudFormationStackSet"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#CloudFormationStack"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#recordType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>record type</rdfs:label>
    <rdfs:comment>The DNS record type (e.g. A, CNAME, MX, TXT)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#Route53RecordSet"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasCondition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has condition</rdfs:label>
    <rdfs:comment>Relates policy statements to their conditions</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#PolicyStatement"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#Condition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#controlledByServiceControlPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>controlled by service control policy</rdfs:label>
    <rdfs:comment>Relates AWS accounts to service control policies</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSAccount"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#ServiceControlPolicy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#dependencyOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>dependency of</rdfs:label>
    <rdfs:comment>Inverse of depends on</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#dependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#secretName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>secret name</rdfs:label>
    <rdfs:comment>Name of the secret in Secrets Manager</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#SecretsManagerSecret"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#producesModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>produces model</rdfs:label>
    <rdfs:comment>Relates a SageMaker training job to the model artifact it produces</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#SageMakerTrainingJob"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#SageMakerModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#invokesModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>invokes model</rdfs:label>
    <rdfs:comment>Relates a Bedrock agent to a foundation model it may invoke</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#uses"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#BedrockAgent"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#FoundationModel"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasSubscriber">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has subscriber</rdfs:label>
    <rdfs:comment>Inverse of subscribes to</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#subscribesTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#SNSTopic">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SNS Topic</rdfs:label>
    <rdfs:comment>An Amazon Simple Notification Service topic for pub/sub messaging</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IntegrationResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#approvalRequired">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>approval required</rdfs:label>
    <rdfs:comment>Whether approval is required for resource creation or modification</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#WAFWebACL">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>WAF Web ACL</rdfs:label>
    <rdfs:comment>An AWS WAF web access control list that filters web requests based on configurable rules</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#regionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
