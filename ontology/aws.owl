    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>default action</rdfs:label>
    <rdfs:comment>The action (ALLOW or BLOCK) a WAF web ACL takes when no rule matches a request</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#WAFWebACL"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
