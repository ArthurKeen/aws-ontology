  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#Action">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Action</rdfs:label>
    <rdfs:comment>An AWS API action</rdfs:comment>
