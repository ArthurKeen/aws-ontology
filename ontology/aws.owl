    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#BedrockGuardrail">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Bedrock Guardrail</rdfs:label>
    <rdfs:comment>A content-filtering policy applied to Bedrock model invocations</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#volumeType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>volume type</rdfs:label>
    <rdfs:comment>EBS volume type</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#EBSVolume"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#CloudWatchMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CloudWatch Metric</rdfs:label>
    <rdfs:comment>A CloudWatch metric</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#replaces">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>replaces</rdfs:label>
    <rdfs:comment>Inverse of replaced by</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#replacedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#CloudFormationStackSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CloudFormation StackSet</rdfs:label>
    <rdfs:comment>A CloudFormation StackSet that deploys a common stack template across multiple accounts and regions</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DeploymentResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#sqlQuery">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>SQL query</rdfs:label>
    <rdfs:comment>The SQL text of an Athena query execution</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AthenaQueryExecution"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasRuleGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has rule group</rdfs:label>
    <rdfs:comment>Relates a WAF web ACL to a rule group it evaluates against incoming requests</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#uses"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#WAFWebACL"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#WAFRuleGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#EBSSnapshot">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>EBS Snapshot</rdfs:label>
    <rdfs:comment>A snapshot of an EBS volume</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#StorageResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#httpMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>HTTP method</rdfs:label>
    <rdfs:comment>HTTP method (GET, POST, PUT, DELETE, etc.)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#APIGatewayMethod"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#SecurityHubHub">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Security Hub</rdfs:label>
    <rdfs:comment>The AWS Security Hub resource enabling centralized security finding aggregation for an account and region</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#referencesIPSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>references IP set</rdfs:label>
    <rdfs:comment>Relates a WAF rule group to an IP set it references in a match condition</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#uses"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#WAFRuleGroup"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#WAFIPSet"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#stageOrder">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>stage order</rdfs:label>
    <rdfs:comment>The sequential position of a stage within its pipeline</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#CodePipelineStage"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has resource</rdfs:label>
    <rdfs:comment>Relates an API Gateway to its resources</rdfs:comment>
    <rdfs:comment>Relates policy statements to their target resources</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#APIGateway"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#PolicyStatement"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#APIGatewayResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#Resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#visibilityTimeoutSeconds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>visibility timeout seconds</rdfs:label>
    <rdfs:comment>SQS message visibility timeout in seconds</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#SQSQueue"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#DatabaseResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:label>Database Resource</rdfs:label>
    <rdfs:comment>Base class for database resources</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#IntegrationResource"/>
    <owl:disjointWith rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
    <skos:prefLabel>Database Resource</skos:prefLabel>
    <skos:inScheme rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResourceCategoryScheme"/>
    <skos:topConceptOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResourceCategoryScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#Effect">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Effect</rdfs:label>
    <rdfs:comment>The effect of a policy statement (Allow/Deny)</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#SecurityHubStandardsSubscription">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Security Hub Standards Subscription</rdfs:label>
    <rdfs:comment>A subscription of a Security Hub account to a compliance standard (e.g. CIS AWS Foundations)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb6">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/aws-ontology#hasTaskDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#deploysStack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>deploys stack</rdfs:label>
    <rdfs:comment>Relates a CodePipeline deploy stage to the CloudFormation stack it deploys</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#uses"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#CodePipelineStage"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#CloudFormationStack"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#SSMPatchBaseline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SSM Patch Baseline</rdfs:label>
    <rdfs:comment>A Systems Manager patch baseline defining approved patches for managed instances</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#succeeds">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:label>succeeds</rdfs:label>
    <rdfs:comment>Indicates logical succession relationship between resources</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#associatedWithGateway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>associated with gateway</rdfs:label>
    <rdfs:comment>Relates a transit virtual interface to the Direct Connect gateway it is associated with</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#dependsOn"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#DirectConnectVirtualInterface"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#DirectConnectGateway"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#runsInWorkGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>runs in workgroup</rdfs:label>
    <rdfs:comment>Relates an Athena query execution to the workgroup it ran under</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#dependsOn"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AthenaQueryExecution"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AthenaWorkGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#runsPod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>runs pod</rdfs:label>
    <rdfs:comment>Relates EKS node groups or clusters to their pods</rdfs:comment>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#EKSPod"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#storedInRepository">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>stored in repository</rdfs:label>
    <rdfs:comment>Relates container images to their ECR repository</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ContainerImage"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#ECRRepository"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasFinding">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has finding</rdfs:label>
    <rdfs:comment>Relates a GuardDuty detector to a finding it generated</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#contains"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#GuardDutyDetector"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#GuardDutyFinding"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has method</rdfs:label>
    <rdfs:comment>Relates an API Gateway resource to its HTTP methods</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#APIGatewayResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#APIGatewayMethod"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#SageMakerModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>SageMaker Model</rdfs:label>
    <rdfs:comment>A trained SageMaker model artifact ready for deployment</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#KinesisStream">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Kinesis Stream</rdfs:label>
    <rdfs:comment>A Kinesis Data Stream for real-time data ingestion</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#CloudTrailLog">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>CloudTrail Log</rdfs:label>
    <rdfs:comment>A CloudTrail log entry</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#MonitoringResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#usesKnowledgeBase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>uses knowledge base</rdfs:label>
    <rdfs:comment>Relates a Bedrock agent to a knowledge base it queries for retrieval-augmented generation</rdfs:comment>
