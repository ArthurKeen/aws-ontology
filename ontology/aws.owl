    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <rdfs:label>is publicly accessible</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#isSourceFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
