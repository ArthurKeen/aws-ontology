    <skos:prefLabel>Compute Resource</skos:prefLabel>
    <skos:inScheme rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResourceCategoryScheme"/>
    <skos:topConceptOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResourceCategoryScheme"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">0</owl:minCardinality>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/aws-ontology#memberOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#AWSAccount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>AWS Account</rdfs:label>
    <rdfs:comment>An AWS account that can contain multiple services and resources</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#stepFunctionTriggeredBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>step function triggered by</rdfs:label>
    <rdfs:comment>Inverse of triggers step function</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#triggersStepFunction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#resourceId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>resource ID</rdfs:label>
    <rdfs:comment>AWS resource identifier</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#availabilityZoneOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>availability zone of</rdfs:label>
    <rdfs:comment>Inverse of has availability zone</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AvailabilityZone"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSRegion"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#hasAvailabilityZone"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#appliesTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>applies to</rdfs:label>
    <rdfs:comment>Indicates that a policy or security group applies to a resource</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#shardCount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>shard count</rdfs:label>
    <rdfs:comment>The number of shards provisioned for a Kinesis stream</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#KinesisStream"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#chargedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>charged by</rdfs:label>
    <rdfs:comment>Inverse of incurs charge for</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#incursChargeFor"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#eventBusName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>event bus name</rdfs:label>
    <rdfs:comment>Name of the EventBridge event bus</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#EventBridge"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#isSourceFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>is source for</rdfs:label>
    <rdfs:comment>Indicates source relationship between resources</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#belongsToVPC">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
