  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#allocatesCostTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>allocates cost to</rdfs:label>
