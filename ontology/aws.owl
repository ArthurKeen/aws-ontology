    <rdfs:label>used by</rdfs:label>
    <rdfs:comment>Inverse of uses</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#uses"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#uses">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>uses</rdfs:label>
