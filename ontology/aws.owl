    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#EC2AMI">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
