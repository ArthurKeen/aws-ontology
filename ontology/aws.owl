<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns="https://w3id.org/arango-solutions/aws-ontology#"
   xmlns:dcterms="http://purl.org/dc/terms/"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
   xmlns:skos="http://www.w3.org/2004/02/skos/core#"
>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dcterms:contributor xml:lang="en">Claude (Anthropic) -- LLM-assisted authoring and verification</dcterms:contributor>
    <dcterms:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-07-15</dcterms:created>
    <dcterms:creator xml:lang="en">Arthur Keen</dcterms:creator>
    <dcterms:description xml:lang="en">Authored from AWS public documentation and API reference knowledge -- NOT extracted from a fixed, ingested document corpus, and NOT derived from live AWS API introspection. Every resource type's real-ARN existence is individually checked against AWS's own IAM resource-type reference rather than assumed. Independently validated by OWL 2 DL reasoning, SHACL closed-world shape validation, and an automated test suite (see :provenanceMethod / :verificationMethod for a machine-readable summary).</dcterms:description>
    <dcterms:license rdf:resource="https://opensource.org/license/mit"/>
    <dcterms:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-26</dcterms:modified>
    <dcterms:publisher xml:lang="en">Arango</dcterms:publisher>
    <dcterms:source xml:lang="en">AWS API Reference documentation</dcterms:source>
    <dcterms:source xml:lang="en">AWS Service Documentation (docs.aws.amazon.com)</dcterms:source>
    <dcterms:source xml:lang="en">AWS Whitepapers</dcterms:source>
    <rdfs:comment>An ontology for describing AWS resources, services, and their relationships. Not affiliated with or endorsed by Amazon Web Services; AWS service names are trademarks of Amazon.com, Inc. or its affiliates.</rdfs:comment>
    <rdfs:label>AWS Resource Ontology</rdfs:label>
    <owl:versionIRI rdf:resource="https://w3id.org/arango-solutions/aws-ontology/0.6.0"/>
    <owl:versionInfo>0.6.0</owl:versionInfo>
    <provenanceMethod>domain-knowledge-authored-and-verified</provenanceMethod>
    <verificationMethod>automated-test-suite</verificationMethod>
    <verificationMethod>owl-dl-reasoning</verificationMethod>
    <verificationMethod>shacl-validation</verificationMethod>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AIResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment>Base class for artificial intelligence and generative AI resources</rdfs:comment>
    <rdfs:label>AI Resource</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ComputeResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DatabaseResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IntegrationResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#MonitoringResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#NetworkingResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#SecurityResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#StorageResource"/>
    <skos:inScheme rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResourceCategoryScheme"/>
    <skos:prefLabel>AI Resource</skos:prefLabel>
    <skos:topConceptOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResourceCategoryScheme"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#APIGateway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An Amazon API Gateway for creating, publishing, maintaining, monitoring, and securing REST and WebSocket APIs</rdfs:comment>
    <rdfs:label>API Gateway</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#NetworkingResource"/>
    <rdfs:subClassOf rdf:nodeID="cb1df88ea4a39cc40a6967bc74dd57933c2c96255396d30ff94c1a12766ef81c481"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#APIGatewayMethod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An HTTP method for an API Gateway resource</rdfs:comment>
    <rdfs:label>API Gateway Method</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#APIGatewayResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A logical entity that an app developer accesses via API Gateway</rdfs:comment>
    <rdfs:label>API Gateway Resource</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#APIGatewayStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A logical reference to a lifecycle state of an API Gateway deployment</rdfs:comment>
    <rdfs:label>API Gateway Stage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AWSAccount">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An AWS account that can contain multiple services and resources</rdfs:comment>
    <rdfs:label>AWS Account</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AWSManagedPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An AWS-provided managed policy</rdfs:comment>
    <rdfs:label>AWS Managed Policy</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ManagedPolicy"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#CustomerManagedPolicy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AWSRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A geographical region containing AWS resources</rdfs:comment>
    <rdfs:label>AWS Region</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AWSResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Base class for all AWS resources</rdfs:comment>
    <rdfs:label>AWS Resource</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Entity"/>
    <rdfs:subClassOf rdf:nodeID="cb2ab2603a58f8871702ab7a2f83f1900b433f6b3bf07007823fcfa5520c3c97854"/>
    <owl:hasKey rdf:nodeID="cb28afc664be80c1a05a91de708a8b5874be42154c873a0b48f7802a1fec905dba7"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AWSResourceCategoryScheme">
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
    <rdfs:label>AWS Resource Category Scheme</rdfs:label>
    <skos:hasTopConcept rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AIResource"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ComputeResource"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DatabaseResource"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityResource"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IntegrationResource"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/arango-solutions/aws-ontology#MonitoringResource"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/arango-solutions/aws-ontology#NetworkingResource"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/arango-solutions/aws-ontology#SecurityResource"/>
    <skos:hasTopConcept rdf:resource="https://w3id.org/arango-solutions/aws-ontology#StorageResource"/>
    <skos:prefLabel>AWS Resource Category Scheme</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AccountAssignment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Assigns an Identity Center principal to an AWS account via a permission set</rdfs:comment>
    <rdfs:label>Account Assignment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#Action">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An AWS API action</rdfs:comment>
    <rdfs:label>Action</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AnalyticsResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>Base class for data analytics, ETL, streaming, and search-analytics resources</rdfs:comment>
    <rdfs:label>Analytics Resource</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AIResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ComputeResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DatabaseResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IntegrationResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#MonitoringResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#NetworkingResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#SecurityResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#StorageResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AthenaDataCatalog">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A data source catalog registered with Athena (e.g. the AWS Glue Data Catalog)</rdfs:comment>
    <rdfs:label>Athena Data Catalog</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AthenaQueryExecution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A single execution of a SQL query against Athena</rdfs:comment>
    <rdfs:label>Athena Query Execution</rdfs:label>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/ns/prov#Activity"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AthenaWorkGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An Athena workgroup grouping queries under shared settings and cost controls</rdfs:comment>
    <rdfs:label>Athena WorkGroup</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AutoScalingGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An Amazon EC2 Auto Scaling group</rdfs:comment>
    <rdfs:label>Auto Scaling Group</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#ComputeResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#AvailabilityZone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An isolated location within a region</rdfs:comment>
    <rdfs:label>Availability Zone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#BedrockAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An Amazon Bedrock agent that orchestrates foundation model calls with tools and knowledge bases</rdfs:comment>
    <rdfs:label>Bedrock Agent</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#BedrockDataSource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A data source (e.g. an S3 bucket) ingested into a Bedrock knowledge base</rdfs:comment>
    <rdfs:label>Bedrock Data Source</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#BedrockGuardrail">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A content-filtering policy applied to Bedrock model invocations</rdfs:comment>
    <rdfs:label>Bedrock Guardrail</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#BedrockKnowledgeBase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An Amazon Bedrock knowledge base providing retrieval-augmented generation over ingested data sources</rdfs:comment>
    <rdfs:label>Bedrock Knowledge Base</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CloudFormationChangeSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A CloudFormation change set previewing proposed changes to a stack before they are executed</rdfs:comment>
    <rdfs:label>CloudFormation Change Set</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DeploymentResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CloudFormationStack">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A CloudFormation stack representing a collection of AWS resources managed as a single provisioning unit</rdfs:comment>
    <rdfs:label>CloudFormation Stack</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DeploymentResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CloudFormationStackSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A CloudFormation StackSet that deploys a common stack template across multiple accounts and regions</rdfs:comment>
    <rdfs:label>CloudFormation StackSet</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DeploymentResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CloudFrontDistribution">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An Amazon CloudFront content delivery network distribution</rdfs:comment>
    <rdfs:label>CloudFront Distribution</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CloudTrailLog">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A CloudTrail log entry</rdfs:comment>
    <rdfs:label>CloudTrail Log</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#MonitoringResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CloudWatchAlarm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A CloudWatch alarm</rdfs:comment>
    <rdfs:label>CloudWatch Alarm</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#MonitoringResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CloudWatchMetric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A CloudWatch metric</rdfs:comment>
    <rdfs:label>CloudWatch Metric</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#MonitoringResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CodePipelinePipeline">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An AWS CodePipeline continuous-delivery pipeline that orchestrates build, test, and deploy stages</rdfs:comment>
    <rdfs:label>CodePipeline Pipeline</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DeploymentResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CodePipelineStage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A named stage within a CodePipeline pipeline (e.g. Source, Build, Deploy) executing one or more actions in sequence</rdfs:comment>
    <rdfs:label>CodePipeline Stage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DeploymentResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CognitoIdentityPool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An Amazon Cognito identity pool that federates identity providers to grant temporary AWS credentials</rdfs:comment>
    <rdfs:label>Cognito Identity Pool</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CognitoIdentityProvider">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A SAML, OIDC, or social (Google/Facebook/LoginWithAmazon/SignInWithApple) identity provider configured within a Cognito user pool for federated sign-in</rdfs:comment>
    <rdfs:label>Cognito Identity Provider</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CognitoUserPool">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An Amazon Cognito user directory for application end-user sign-up and sign-in</rdfs:comment>
    <rdfs:label>Cognito User Pool</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#CognitoUserPoolClient">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An application client configured against a Cognito user pool</rdfs:comment>
    <rdfs:label>Cognito User Pool Client</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#ComputeResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdf:type rdf:resource="http://www.w3.org/2004/02/skos/core#Concept"/>
    <rdfs:comment>Base class for compute resources</rdfs:comment>
    <rdfs:label>Compute Resource</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AWSResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#DatabaseResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IntegrationResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#MonitoringResource"/>
    <owl:disjointWith rdf:resource="https://w3id.org/arango-solutions/aws-ontology#NetworkingResource"/>
