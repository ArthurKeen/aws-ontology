    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#enabled">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>enabled</rdfs:label>
    <rdfs:comment>Whether resource is enabled</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#queriesTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>queries table</rdfs:label>
    <rdfs:comment>Relates an Athena query execution to a Glue table it queried</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#uses"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AthenaQueryExecution"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#GlueTable"/>
