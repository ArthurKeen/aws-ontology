    <rdfs:comment>Cost center identifier for billing allocation</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#GuardDutyDetector">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>GuardDuty Detector</rdfs:label>
    <rdfs:comment>An Amazon GuardDuty detector monitoring an account and region for threats</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasRouteTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has route table</rdfs:label>
    <rdfs:comment>Relates a Transit Gateway to a route table it manages</rdfs:comment>
