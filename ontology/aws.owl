    <rdfs:comment>Indicates governance approval requirements</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#optimizedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>optimized by</rdfs:label>
    <rdfs:comment>Indicates cost or performance optimization relationships</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#provisionsResource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>provisions resource</rdfs:label>
    <rdfs:comment>Relates a CloudFormation stack to an AWS resource it provisions and manages</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#manages"/>
