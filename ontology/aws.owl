  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ModelInvocation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Model Invocation</rdfs:label>
    <rdfs:comment>A single invocation of a foundation model by a Bedrock agent</rdfs:comment>
