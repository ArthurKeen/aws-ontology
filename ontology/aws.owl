  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ContainerImage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Container Image</rdfs:label>
    <rdfs:comment>A container image stored in ECR or referenced by container services</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb4"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#StorageResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#desiredNodes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
