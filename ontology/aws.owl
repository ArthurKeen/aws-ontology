  <rdf:Description rdf:about="https://w3id.org/arango-solutions/aws-ontology#assignsPrincipal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment>Relates an account assignment to the Identity Center principal it applies to</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/arango-solutions/aws-ontology#AccountAssignment"/>
    <rdfs:label>assigns principal</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/arango-solutions/aws-ontology#IdentityCenterPrincipal"/>
