    <rdfs:comment>An Application Load Balancer or Network Load Balancer target group</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#lastAuditDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>last audit date</rdfs:label>
    <rdfs:comment>Date of the last compliance audit</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#DirectConnectGateway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Direct Connect Gateway</rdfs:label>
    <rdfs:comment>A global AWS Direct Connect gateway connecting Direct Connect virtual interfaces to VPCs across regions via Transit Gateway or virtual private gateway</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#complianceStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>compliance status</rdfs:label>
    <rdfs:comment>Current compliance status (compliant, non-compliant, pending, exempt)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#GlueCrawler">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Glue Crawler</rdfs:label>
    <rdfs:comment>A Glue crawler that inspects data sources and populates the Data Catalog</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#contains">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>contains</rdfs:label>
    <rdfs:comment>General containment relationship</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#performanceMode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>performance mode</rdfs:label>
    <rdfs:comment>EFS performance mode</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#EFSFileSystem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#targetKeyId">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>target key ID</rdfs:label>
    <rdfs:comment>References the target KMS key for an alias</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#KMSAlias"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#KMSKey"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#BedrockAgent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Bedrock Agent</rdfs:label>
    <rdfs:comment>An Amazon Bedrock agent that orchestrates foundation model calls with tools and knowledge bases</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has policy</rdfs:label>
    <rdfs:comment>Relates IAM entities (users, roles, groups) to their attached policies</rdfs:comment>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#IAMPolicy"/>
    <owl:equivalentProperty rdf:resource="http://www.semanticweb.org/aws-ontology#hasPolicyAttachment"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#RDSCluster">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RDS Cluster</rdfs:label>
    <rdfs:comment>An Amazon RDS database cluster</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#DatabaseResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#Organization">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Organization</rdfs:label>
    <rdfs:comment>The root container for an AWS Organization, grouping member accounts under centralized management</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#canAssumeRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>can assume role</rdfs:label>
    <rdfs:comment>Relates an IAM principal (user or role) to an IAM role it is permitted to assume via sts:AssumeRole</rdfs:comment>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#IAMRole"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#routesTrafficThrough">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>routes traffic through</rdfs:label>
    <rdfs:comment>Indicates traffic routing relationships</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#RouteTable"/>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#dependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasTaskDefinition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has task definition</rdfs:label>
    <rdfs:comment>Relates ECS services/tasks to their task definition</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ECSService"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#ECSTaskDefinition"/>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#contains"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/aws-ontology#hasStage"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#incursChargeFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>incurs charge for</rdfs:label>
    <rdfs:comment>Indicates that one resource incurs costs for another</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#fromPort">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>from port</rdfs:label>
    <rdfs:comment>Starting port number for security group rule</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityGroupRule"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#bucketVersioning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>bucket versioning</rdfs:label>
    <rdfs:comment>S3 bucket versioning status</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#S3Bucket"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#attachmentOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>attachment of</rdfs:label>
    <rdfs:comment>Inverse of attached to</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#attachedTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#KinesisAnalyticsApplication">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Kinesis Analytics Application</rdfs:label>
    <rdfs:comment>A Kinesis Data Analytics (Managed Service for Apache Flink) application processing a stream</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AnalyticsResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#keySpec">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>key spec</rdfs:label>
    <rdfs:comment>KMS key specification</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#KMSKey"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#ElasticIP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Elastic IP</rdfs:label>
    <rdfs:comment>An Elastic IP address</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#readsFromTable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>reads from table</rdfs:label>
    <rdfs:comment>Relates a Glue ETL job to a table it reads as a source</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/aws-ontology#uses"/>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#GlueJob"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#GlueTable"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#IAMPolicy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>IAM Policy</rdfs:label>
    <rdfs:comment>Base class for all IAM policies</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb11"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#stackStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>stack status</rdfs:label>
    <rdfs:comment>The current status of a CloudFormation stack (e.g. CREATE_COMPLETE, UPDATE_IN_PROGRESS, ROLLBACK_COMPLETE)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#CloudFormationStack"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#audits">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>audits</rdfs:label>
    <rdfs:comment>Inverse of audited by</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#AWSResource"/>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#auditedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#manages">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>manages</rdfs:label>
    <rdfs:comment>Indicates management relationship between resources</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#tableName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>table name</rdfs:label>
    <rdfs:comment>DynamoDB table name</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#DynamoDBTable"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#containerImageUsedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>container image used by</rdfs:label>
    <rdfs:comment>Inverse of uses container image</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#usesContainerImage"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#taskDefinitionOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>task definition of</rdfs:label>
    <rdfs:comment>Inverse of has task definition</rdfs:comment>
    <owl:inverseOf rdf:resource="http://www.semanticweb.org/aws-ontology#hasTaskDefinition"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#WAFRuleGroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>WAF Rule Group</rdfs:label>
    <rdfs:comment>A reusable collection of AWS WAF rules that can be referenced by one or more web ACLs</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#SecurityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#IAMRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>IAM Role</rdfs:label>
    <rdfs:comment>An IAM role entity</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb8"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#hasHealthCheck">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has health check</rdfs:label>
    <rdfs:comment>Relates a Route 53 record set to the health check governing its failover routing</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#Route53RecordSet"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#Route53HealthCheck"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#launchType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>launch type</rdfs:label>
    <rdfs:comment>ECS launch type (EC2 or FARGATE)</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ECSService"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#PermissionSet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Permission Set</rdfs:label>
    <rdfs:comment>An IAM Identity Center permission set defining the permissions granted by an account assignment</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb14"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#IdentityResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#BedrockKnowledgeBase">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Bedrock Knowledge Base</rdfs:label>
    <rdfs:comment>An Amazon Bedrock knowledge base providing retrieval-augmented generation over ingested data sources</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#FoundationModel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Foundation Model</rdfs:label>
    <rdfs:comment>An Amazon Bedrock foundation model available for invocation</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#AIResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#attachesVPC">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>attaches VPC</rdfs:label>
    <rdfs:comment>Relates a Transit Gateway attachment to the VPC it connects</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#TransitGatewayAttachment"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#VPC"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#APIGateway">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>API Gateway</rdfs:label>
    <rdfs:comment>An Amazon API Gateway for creating, publishing, maintaining, monitoring, and securing REST and WebSocket APIs</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb2"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#FargateService">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Fargate Service</rdfs:label>
    <rdfs:comment>A serverless container service using AWS Fargate</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#ComputeResource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb5">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/aws-ontology#runsOnCluster"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#memberOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>member of</rdfs:label>
    <rdfs:comment>Relates IAM users to their groups</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#IAMUser"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#IAMGroup"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#keyUsage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>key usage</rdfs:label>
    <rdfs:comment>KMS key usage</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#KMSKey"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#NetworkInterface">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Network Interface</rdfs:label>
    <rdfs:comment>An Elastic Network Interface (ENI)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkingResource"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#usesFargate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>uses Fargate</rdfs:label>
    <rdfs:comment>Indicates that a service uses AWS Fargate for serverless containers</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#ECSService"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#attachedToSubnet">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>attached to subnet</rdfs:label>
    <rdfs:comment>Network interface attachment to subnet</rdfs:comment>
    <rdfs:domain rdf:resource="http://www.semanticweb.org/aws-ontology#NetworkInterface"/>
    <rdfs:range rdf:resource="http://www.semanticweb.org/aws-ontology#Subnet"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#StepFunction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Step Function</rdfs:label>
    <rdfs:comment>An AWS Step Functions state machine for coordinating distributed services</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb10"/>
    <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/aws-ontology#ComputeResource"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfec7b4db958c410a89db4f85dc64226eb8">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
    <owl:onProperty rdf:resource="http://www.semanticweb.org/aws-ontology#hasTrustRelationship"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.semanticweb.org/aws-ontology#EKSPod">
